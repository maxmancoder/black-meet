<%- include('head.ejs') %>
<link rel="stylesheet" href="<%- asset('assets/css/dashboard.css') %>"/>
</head>
<body class="bm-dash font-body-md">

<!-- ambient background (pure CSS, no image) -->
<div class="dash-ambient" aria-hidden="true">
    <span class="dash-ambient-glow"></span>
    <span class="dash-ambient-grid"></span>
</div>

<a class="dash-skip" href="#dash-main">پرش به محتوای اصلی</a>

<!-- ================= Desktop sidebar ================= -->
<aside class="dash-sidebar" aria-label="منوی کناری">
    <%- include('dash_sidebar', { drawer: false, activePage: 'members' }) %>
</aside>

<!-- ================= Mobile drawer ================= -->
<div id="dash-drawer" class="dash-drawer" aria-hidden="true">
    <div class="dash-drawer-backdrop" data-drawer-close></div>
    <div class="dash-drawer-panel" role="dialog" aria-modal="true" aria-label="منوی موبایل">
        <%- include('dash_sidebar', { drawer: true, activePage: 'members' }) %>
    </div>
</div>

<!-- ================= Shell ================= -->
<div class="dash-shell">

    <header class="dash-header" id="dash-header">
        <button type="button" class="dash-iconbtn dash-burger" data-no-loader data-drawer-open
                aria-label="باز کردن منو" aria-controls="dash-drawer" aria-expanded="false">
            <%- icon('menu') %>
        </button>

        <a class="dash-header-brand" href="<%- url('home') %>" aria-label="Black Meet — خانه">
            <%- brandMark('dash-header-brand-img') %>
            <span>Black Meet</span>
        </a>

        <span class="dash-crumb" aria-hidden="true">
            <span class="dash-crumb-home">خانه</span>
            <span class="dash-crumb-sep">/</span>
            <span class="dash-crumb-cur">مدیریت اعضا</span>
        </span>

        <div class="dash-header-spacer"></div>

        <a class="dash-link" href="<%- url('home') %>" data-no-loader>
            <%- icon('arrow_forward') %><span>بازگشت</span>
        </a>

        <button type="button" class="dash-header-user" data-no-loader data-user-menu-trigger
                aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" aria-label="منوی حساب کاربری">
            <span class="dash-avatar dash-avatar-sm" style="background:<%- esc(me.avatar_color) %>"><% if (me.avatar) { %><img src="<%- esc(avatarUrl(me.avatar)) %>" alt=""/><% } else { %><%- esc(initials) %><% } %></span>
            <span class="dash-header-user-name"><%- esc(me.display_name) %></span>
            <%- icon('more_vert', 'dash-header-user-more') %>
        </button>
    </header>

    <main class="dash-main dash-members" id="dash-main">

        <section class="dash-page-head">
            <p class="dash-page-eyebrow"><%- icon('groups') %><span>مدیریت سامانه</span></p>
            <h1 class="dash-page-title">مدیریت اعضا</h1>
            <p class="dash-page-sub">
                کاربران را ببینید، درجه و دسترسی‌شان را تغییر دهید و درخواست‌های ایجاد حساب را بررسی کنید.
            </p>
        </section>

        <!-- section switcher (was the left rail; now chips above the content) -->
        <nav class="dash-chips mem-tabs" id="mem-tabs" role="group" aria-label="بخش‌های مدیریت اعضا">
            <% if (canMembers) { %>
            <button type="button" id="nav-members" class="dash-chip is-on" data-no-loader data-section="members"
                    onclick="switchSection('members')" aria-pressed="true">
                <%- icon('group', '', true) %><span>نمایش اعضا</span>
            </button>
            <% } %>
            <% if (canRequests) { %>
            <button type="button" id="nav-requests" class="dash-chip<%- canMembers ? '' : ' is-on' %>" data-no-loader data-section="requests"
                    onclick="switchSection('requests')" aria-pressed="<%- canMembers ? 'false' : 'true' %>">
                <%- icon('person', '', true) %><span>درخواست ایجاد حساب</span>
                <% if (pendingCount > 0) { %>
                <span class="req-badge"><%- toFaDigits(pendingCount) %></span>
                <% } %>
            </button>
            <% } %>
        </nav>

        <!-- ================= SECTION: member list ================= -->
        <% if (canMembers) { %>
        <section id="section-members" class="dash-card" aria-labelledby="members-title">
            <div class="dash-card-head">
                <span class="dash-card-ico dash-card-ico-accent"><%- icon('group') %></span>
                <div>
                    <h2 class="dash-card-title" id="members-title">نمایش اعضا</h2>
                    <p class="dash-card-sub">اطلاعات کاربران را ببینید و ویرایش کنید؛ کاربر محدود‌شده نمی‌تواند تماس جدید ایجاد کند.</p>
                </div>
            </div>

            <!-- signup mode dropdown (above the user list) -->
            <% if (canChangeMode) { %>
            <div class="mem-mode">
                <span class="mem-mode-label"><%- icon('person') %><span>حالت ایجاد حساب</span></span>
                <div class="mem-menu-anchor">
                    <button id="mode-btn" type="button" data-no-loader data-no-soft onclick="toggleModeMenu(event)"
                            class="mem-mode-btn" aria-haspopup="true" aria-expanded="false" aria-controls="mode-menu">
                        <span class="mem-mode-left">
                            <span id="mode-dot" class="w-2.5 h-2.5 rounded-full flex-shrink-0 bg-secondary"></span>
                            <span id="mode-label" class="mem-mode-text">—</span>
                        </span>
                        <span class="bm-caret" aria-hidden="true"></span>
                    </button>
                    <div id="mode-menu" class="hidden mem-mode-menu glass-panel" role="menu" aria-label="حالت ایجاد حساب">
                        <button type="button" class="mode-opt" data-mode="open" role="menuitem" onclick="setSignupMode('open')">
                            <span class="mode-opt-icon"><%- icon('login', '', true) %></span>
                            <span class="min-w-0">
                                <span class="mem-opt-title">ایجاد حساب آزاد</span>
                                <span class="mem-opt-sub">هر کاربری می‌تواند بدون محدودیت حساب بسازد</span>
                            </span>
                            <span class="mode-opt-check hidden" aria-hidden="true"><%- icon('check_circle', '', true) %></span>
                        </button>
                        <button type="button" class="mode-opt" data-mode="approval" role="menuitem" onclick="setSignupMode('approval')">
                            <span class="mode-opt-icon"><%- icon('shield_person', '', true) %></span>
                            <span class="min-w-0">
                                <span class="mem-opt-title">فقط با تایید مدیر</span>
                                <span class="mem-opt-sub">درخواست‌ها ثبت و پس از تایید شما فعال می‌شوند</span>
                            </span>
                            <span class="mode-opt-check hidden" aria-hidden="true"><%- icon('check_circle', '', true) %></span>
                        </button>
                        <button type="button" class="mode-opt" data-mode="closed" role="menuitem" onclick="setSignupMode('closed')">
                            <span class="mode-opt-icon"><%- icon('block', '', true) %></span>
                            <span class="min-w-0">
                                <span class="mem-opt-title">غیرفعال</span>
                                <span class="mem-opt-sub">ایجاد حساب جدید برای همه متوقف است</span>
                            </span>
                            <span class="mode-opt-check hidden" aria-hidden="true"><%- icon('check_circle', '', true) %></span>
                        </button>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Toolbar: live search + page size -->
            <div class="mem-toolbar">
                <div class="mem-search-row">
                    <div class="dash-field">
                        <span class="dash-field-ico" aria-hidden="true"><%- icon('search') %></span>
                        <input id="member-search" class="dash-input bm-search" type="text" autocomplete="off"
                               placeholder="جستجوی نام نمایشی، نام کاربری، ایمیل یا شماره تلفن…"
                               aria-label="جستجوی اعضا"/>
                    </div>
                    <div class="mem-size-row">
                        <span class="mem-size-label">نمایش</span>
                        <!-- the native <select> stays the value store (render() reads it);
                             this is the themed face the user actually clicks -->
                        <div class="mem-menu-anchor" style="position:relative">
                            <button type="button" id="page-size-btn" data-no-loader data-no-soft
                                    onclick="togglePageSizeMenu(event)" aria-haspopup="listbox" aria-expanded="false"
                                    class="mem-size-btn">
                                <span id="page-size-label">۲۵ کاربر</span>
                                <span class="bm-caret" aria-hidden="true"></span>
                            </button>
                            <div id="page-size-menu" class="hidden mem-mode-menu glass-panel" role="listbox" aria-label="تعداد نمایش">
                                <button type="button" class="mode-opt" data-size="25" role="option" onclick="setPageSize(25)"><span class="mem-opt-title">۲۵ کاربر</span></button>
                                <button type="button" class="mode-opt" data-size="50" role="option" onclick="setPageSize(50)"><span class="mem-opt-title">۵۰ کاربر</span></button>
                                <button type="button" class="mode-opt" data-size="100" role="option" onclick="setPageSize(100)"><span class="mem-opt-title">۱۰۰ کاربر</span></button>
                            </div>
                        </div>
                        <select id="page-size" class="hidden" aria-hidden="true" tabindex="-1">
                            <option value="25">۲۵ کاربر</option>
                            <option value="50">۵۰ کاربر</option>
                            <option value="100">۱۰۰ کاربر</option>
                        </select>
                    </div>
                </div>
                <p id="result-count" class="mem-count"></p>
            </div>

            <div id="user-cards" class="mem-grid" data-no-soft></div>
        </section>
        <% } %>

        <!-- ================= SECTION: account creation requests ================= -->
        <% if (canRequests) { %>
        <section id="section-requests" class="dash-card mem-requests<%- canMembers ? ' hidden' : '' %>" aria-labelledby="requests-title">
            <div class="dash-card-head">
                <span class="dash-card-ico dash-card-ico-mint"><%- icon('person') %></span>
                <div>
                    <h2 class="dash-card-title" id="requests-title">درخواست ایجاد حساب</h2>
                    <p class="dash-card-sub">درخواست‌های ثبت‌نام کاربران جدید را بررسی کنید؛ پس از تایید، حساب فعال و قابل ورود می‌شود.</p>
                </div>
            </div>
            <div id="request-list" class="mem-grid" data-no-soft></div>
        </section>
        <% } %>

        <p class="dash-foot-note">
            <%- icon('lock') %>
            <span>فقط مدیر اصلی می‌تواند درجه‌ها را تغییر دهد و حساب‌ها را تایید کند.</span>
        </p>
    </main>
</div>

<!-- ===== Edit user modal ===== -->
<div id="edit-modal" class="hidden bm-mem-modal" role="dialog" aria-modal="true" aria-labelledby="edit-modal-title">
    <div class="bm-mem-backdrop" onclick="closeEditModal()"></div>
    <div class="bm-mem-sheet" role="document">
        <button type="button" class="dash-iconbtn dash-iconbtn-sm dash-modal-x" data-no-loader
                aria-label="بستن" onclick="closeEditModal()">
            <%- icon('close') %>
        </button>

        <div class="mem-modal-head">
            <span class="mem-modal-ico"><%- icon('badge') %></span>
            <div class="min-w-0">
                <h2 class="mem-modal-title" id="edit-modal-title">ویرایش اطلاعات کاربر</h2>
                <p id="edit-target" class="mem-modal-target"></p>
            </div>
        </div>

        <label class="mem-field-label" for="ed-username">نام کاربری</label>
        <input id="ed-username" class="dash-input dash-input-plain" type="text" dir="ltr" autocomplete="off"/>

        <label class="mem-field-label" for="ed-display-name">نام نمایشی</label>
        <input id="ed-display-name" class="dash-input dash-input-plain" type="text" maxlength="40" autocomplete="off"/>
        <p class="mem-modal-hint">این نام در پیام‌ها، تماس‌ها و فهرست اعضا نمایش داده می‌شود.</p>

        <label class="mem-field-label" for="ed-email">ایمیل</label>
        <input id="ed-email" class="dash-input dash-input-plain" type="email" dir="ltr" autocomplete="off"/>

        <label class="mem-field-label" for="ed-phone">شماره تلفن</label>
        <input id="ed-phone" class="dash-input dash-input-plain" type="tel" dir="ltr" autocomplete="off"/>

        <label class="mem-field-label" for="ed-password">رمز عبور</label>
        <input id="ed-password" class="dash-input dash-input-plain" type="text" placeholder="خالی بگذارید تا تغییر نکند"
               maxlength="128" autocomplete="new-password"/>
        <p class="mem-modal-hint">برای تغییر رمز، مقدار جدید (حداقل ۶ کاراکتر) را وارد کنید.</p>

        <label class="mem-field-label">درجه</label>
        <!-- the native <select> stays the value store (openEditModal/submitEdit read & write
             .value); this is the themed face the user clicks -->
        <div style="position:relative">
            <button type="button" id="ed-rank-btn" data-no-soft onclick="toggleEditRankMenu(event)"
                    aria-haspopup="listbox" aria-expanded="false" class="mem-mode-btn">
                <span id="ed-rank-label">کاربر عادی</span>
                <span class="bm-caret" aria-hidden="true"></span>
            </button>
        </div>
        <select id="ed-rank" class="hidden" aria-hidden="true" tabindex="-1">
            <option value="user">کاربر عادی</option>
            <option value="admin">ادمین</option>
            <option value="premium">ادمین پریمیوم</option>
        </select>
        <p id="ed-rank-lock" class="mem-modal-hint hidden">درجه مدیر اصلی قابل تغییر نیست.</p>

        <div class="mem-modal-actions">
            <button type="button" onclick="submitEdit()" class="dash-btn dash-btn-solid">ذخیره</button>
            <button type="button" onclick="closeEditModal()" class="dash-btn dash-btn-soft">انصراف</button>
        </div>
    </div>
</div>

<!-- the rank menu lives OUTSIDE the edit modal: the modal panel is a scroll container
     with a backdrop-filter, which makes it the containing block for fixed children and
     clipped the menu away. Here it can never be cut off. -->
<div id="ed-rank-menu" class="hidden glass-panel" role="listbox" aria-label="درجه کاربر" style="z-index:110">
    <button type="button" class="mode-opt" data-rank="user" role="option" onclick="setEditRank('user')"><span class="mem-opt-title">کاربر عادی</span></button>
    <button type="button" class="mode-opt" data-rank="admin" role="option" onclick="setEditRank('admin')"><span class="mem-opt-title">ادمین</span></button>
    <button type="button" class="mode-opt" data-rank="premium" role="option" onclick="setEditRank('premium')"><span class="mem-opt-title">ادمین پریمیوم</span></button>
</div>

<%- include('dash_usermenu') %>
<%- include('dash_confirm') %>
<%- include('dash_toast') %>
<%- include('dash_bottomnav', { activePage: 'members' }) %>

<script>
window.CSRF = <%- json(csrf) %>;
window.BASE = <%- json(base) %>;
window.ME_ID = <%- Number(me.id) %>;
window.ME_IS_MANAGER = <%- json(!!me.is_manager) %>;
window.INIT_USERS = <%- json(users) %>;
window.INIT_REQUESTS = <%- json(requests) %>;
window.SIGNUP_MODE = <%- json(signupMode) %>;
window.PERM = { members: <%- json(canMembers) %>, requests: <%- json(canRequests) %>, decide: <%- json(canDecide) %>, changeMode: <%- json(canChangeMode) %> };
</script>
<script src="<%- asset('assets/js/dashboard.js') %>"></script>
<script src="<%- asset('assets/js/admin_members.js') %>"></script>
</body>
</html>
