<%- include('head.ejs') %>
<link rel="stylesheet" href="<%- asset('assets/css/dashboard.css') %>"/>
</head>
<%
  var canMessagesHref = isManager ? url('messages') : url('messages') + '?chat=admin';
  var quotaFull = quota.limit !== 0 && quota.used >= quota.limit;
  var canCreate = !limited && !quotaFull;
  var quotaPct = quota.limit === 0 ? 0 : Math.min(100, Math.round((quota.used / quota.limit) * 100));
  var recentActive = recent.filter(function (m) { return !!m.active; }).length;
%>
<body class="bm-dash font-body-md">

<!-- ambient background (pure CSS, no image) -->
<div class="dash-ambient" aria-hidden="true">
    <span class="dash-ambient-glow"></span>
    <span class="dash-ambient-grid"></span>
</div>

<a class="dash-skip" href="#dash-main">پرش به محتوای اصلی</a>

<!-- ================= Desktop sidebar ================= -->
<aside class="dash-sidebar" aria-label="منوی کناری">
    <%- include('dash_sidebar', { drawer: false }) %>
</aside>

<!-- ================= Mobile drawer ================= -->
<div id="dash-drawer" class="dash-drawer" aria-hidden="true">
    <div class="dash-drawer-backdrop" data-drawer-close></div>
    <div class="dash-drawer-panel" role="dialog" aria-modal="true" aria-label="منوی موبایل">
        <%- include('dash_sidebar', { drawer: true }) %>
    </div>
</div>

<!-- ================= Shell ================= -->
<div class="dash-shell">

    <!-- ---------- Top header ---------- -->
    <header class="dash-header" id="dash-header">
        <button type="button" class="dash-iconbtn dash-burger" data-no-loader data-drawer-open
                aria-label="باز کردن منو" aria-controls="dash-drawer" aria-expanded="false">
            <%- icon('menu') %>
        </button>

        <a class="dash-header-brand" href="<%- url('home') %>" aria-label="Black Meet — خانه">
            <%- brandMark('dash-header-brand-img') %>
            <span>Black Meet</span>
        </a>

        <span class="dash-crumb" aria-hidden="true">
            <span class="dash-crumb-home">خانه</span>
            <span class="dash-crumb-sep">/</span>
            <span class="dash-crumb-cur">داشبورد</span>
        </span>

        <div class="dash-header-spacer"></div>

        <button type="button" class="dash-searchbtn" data-no-loader onclick="bmFocusSearch()"
                aria-label="جستجو در جلسات اخیر">
            <%- icon('search') %>
            <span class="dash-searchbtn-text">جستجوی جلسه…</span>
            <span class="dash-kbd" aria-hidden="true">⌘K</span>
        </button>

        <button id="bell-btn" type="button" class="dash-iconbtn dash-bell" data-no-loader
                onclick="toggleNotifications()" aria-label="پیام‌های عمومی" aria-haspopup="dialog" aria-expanded="false">
            <%- icon('notifications') %>
            <span id="bell-dot" class="dash-bell-dot hidden" aria-hidden="true"></span>
        </button>

        <button type="button" class="dash-header-user" data-no-loader data-user-menu-trigger
                aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" aria-label="منوی حساب کاربری">
            <span class="dash-avatar dash-avatar-sm" style="background:<%- esc(me.avatar_color) %>"><% if (me.avatar) { %><img src="<%- esc(avatarUrl(me.avatar)) %>" alt=""/><% } else { %><%- esc(initials) %><% } %></span>
            <span class="dash-header-user-name"><%- esc(me.display_name) %></span>
            <%- icon('more_vert', 'dash-header-user-more') %>
        </button>
    </header>

    <!-- ---------- Main content ---------- -->
    <main class="dash-main" id="dash-main">

        <!-- Hero -->
        <section class="dash-hero" aria-labelledby="dash-hello">
            <div class="dash-hero-rings" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <div class="dash-hero-body">
                <p class="dash-hero-eyebrow">
                    <span class="dash-live-dot" aria-hidden="true"></span>
                    <span data-greeting>خوش آمدی</span>
                </p>
                <h1 class="dash-hero-title" id="dash-hello">سلام، <%- esc(firstName) %></h1>
                <p class="dash-hero-sub">یک تماس تازه بساز یا با لینک دوستت وارد شو. همه‌چیز امن و رمزنگاری‌شده است.</p>

                <div class="dash-hero-pills">
                    <span class="dash-pill dash-pill-rank">
                        <%- icon('shield_person', '', true) %><%- rankLabel %>
                    </span>
                    <% if (memberSince) { %>
                    <span class="dash-pill"><%- icon('calendar_add_on') %> عضو از <%- toFaDigits(memberSince) %></span>
                    <% } %>
                    <% if (quotaText) { %>
                    <span class="dash-pill"><%- icon('video_call') %> امروز <%- quotaText %></span>
                    <% } %>
                </div>

                <div class="dash-hero-cta">
                    <% if (canCreate) { %>
                    <a class="dash-btn dash-btn-primary dash-btn-lg" href="<%- url('create') %>" data-no-loader>
                        <%- icon('video_call', '', true) %>
                        <span>ایجاد تماس جدید</span>
                    </a>
                    <% } else { %>
                    <button type="button" class="dash-btn dash-btn-primary dash-btn-lg is-disabled" data-no-loader
                            onclick="bmToast(<%- json(limited ? 'حساب شما محدود شده و امکان ایجاد تماس جدید وجود ندارد' : 'سقف تماس امروز شما پر شده است؛ فردا دوباره تلاش کنید') %>, 'error')"
                            aria-disabled="true">
                        <%- icon(limited ? 'block' : 'calendar_add_on', '', true) %>
                        <span><%- limited ? 'حساب محدود شده' : 'سقف امروز پر شد' %></span>
                    </button>
                    <% } %>
                    <button type="button" class="dash-btn dash-btn-ghost dash-btn-lg" data-no-loader onclick="bmFocusJoin()">
                        <%- icon('link') %>
                        <span>پیوستن با لینک</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- Join + quota -->
        <div class="dash-quick">
            <section class="dash-card dash-join" aria-labelledby="dash-join-title">
                <div class="dash-card-head">
                    <span class="dash-card-ico dash-card-ico-accent"><%- icon('login') %></span>
                    <div>
                        <h2 class="dash-card-title" id="dash-join-title">پیوستن به تماس</h2>
                        <p class="dash-card-sub">لینک دعوت یا کد ۱۶ رقمی تماس را وارد کن</p>
                    </div>
                </div>

                <form id="join-form" class="dash-join-form" novalidate>
                    <div class="dash-field">
                        <span class="dash-field-ico" aria-hidden="true"><%- icon('link') %></span>
                        <input id="join-input" class="dash-input" type="text" inputmode="text" autocomplete="off"
                               spellcheck="false" placeholder="مثلاً https://…/meeting?room=ab12cd34ef56gh78"
                               aria-label="لینک یا کد تماس" aria-describedby="join-error"/>
                    </div>
                    <button type="submit" class="dash-btn dash-btn-solid" id="join-submit" data-no-loader>
                        <span class="dash-btn-label">پیوستن</span>
                        <%- icon('arrow_forward', 'dash-btn-ico') %>
                    </button>
                </form>
                <p id="join-error" class="dash-error" role="alert" hidden></p>
                <p class="dash-hint">لینک را از میزبان بگیر؛ بعد از تایید او وارد اتاق می‌شوی.</p>
            </section>

            <section class="dash-card dash-quota" aria-labelledby="dash-quota-title">
                <div class="dash-card-head dash-card-head-tight">
                    <span class="dash-card-ico"><%- icon('calendar_add_on') %></span>
                    <div>
                        <h2 class="dash-card-title" id="dash-quota-title">سقف تماس امروز</h2>
                        <p class="dash-card-sub"><%- quota.limit === 0 ? 'بدون محدودیت روزانه' : 'هر روز نیمه‌شب بازنشانی می‌شود' %></p>
                    </div>
                </div>

                <% if (quota.limit === 0) { %>
                <p class="dash-quota-big"><span>∞</span><small>تماس نامحدود</small></p>
                <div class="dash-meter" aria-hidden="true"><span style="width:100%"></span></div>
                <% } else { %>
                <p class="dash-quota-big">
                    <span><%- toFaDigits(quota.used) %></span>
                    <small>از <%- toFaDigits(quota.limit) %> تماس</small>
                </p>
                <div class="dash-meter<%- quotaFull ? ' is-full' : '' %>" role="progressbar" aria-valuemin="0" aria-valuemax="<%- quota.limit %>"
                     aria-valuenow="<%- quota.used %>" aria-label="سقف تماس امروز">
                    <span style="width:<%- quotaPct %>%"></span>
                </div>
                <p class="dash-quota-note">
                    <% if (quotaFull) { %><%- icon('info') %> امروز به سقف رسیده‌ای؛ فردا دوباره فعال می‌شود.
                    <% } else { %><%- icon('check_circle') %> <%- toFaDigits(quota.limit - quota.used) %> تماس دیگر باقی مانده.
                    <% } %>
                </p>
                <% } %>
            </section>
        </div>

        <!-- Stats (real numbers only) -->
        <section class="dash-stats" aria-label="آمار حساب">
            <div class="dash-stat">
                <span class="dash-stat-ico"><%- icon('video_library') %></span>
                <span class="dash-stat-num" data-stat="total" data-value="<%- stats.totalMeetings %>"><%- toFaDigits(stats.totalMeetings) %></span>
                <span class="dash-stat-label">تماس ساخته‌شده</span>
            </div>
            <div class="dash-stat<%- stats.activeMeetings > 0 ? ' is-live' : '' %>" data-stat-card="active">
                <span class="dash-stat-ico"><%- icon('network_check') %></span>
                <span class="dash-stat-num" data-stat="active" data-value="<%- stats.activeMeetings %>"><%- toFaDigits(stats.activeMeetings) %></span>
                <span class="dash-stat-label">در حال اجرا</span>
            </div>
            <div class="dash-stat">
                <span class="dash-stat-ico"><%- icon('calendar_add_on') %></span>
                <span class="dash-stat-num" data-stat="month" data-value="<%- stats.monthMeetings %>"><%- toFaDigits(stats.monthMeetings) %></span>
                <span class="dash-stat-label">این ماه</span>
            </div>
            <div class="dash-stat">
                <span class="dash-stat-ico"><%- icon('groups') %></span>
                <span class="dash-stat-num" data-stat="guests" data-value="<%- stats.guests %>"><%- toFaDigits(stats.guests) %></span>
                <span class="dash-stat-label">مهمان یکتا</span>
            </div>
        </section>

        <!-- Recent + announcements -->
        <div class="dash-split">
            <section class="dash-card dash-recent" aria-labelledby="dash-recent-title">
                <div class="dash-card-head dash-recent-head">
                    <div class="dash-recent-heading">
                        <span class="dash-card-ico"><%- icon('video_library') %></span>
                        <div>
                            <h2 class="dash-card-title" id="dash-recent-title">جلسات اخیر</h2>
                            <p class="dash-card-sub" id="recent-count"><%- recent.length ? toFaDigits(recent.length) + ' جلسه اخیر' : 'هنوز جلسه‌ای نداری' %></p>
                        </div>
                    </div>
                    <div class="dash-recent-tools">
                        <div class="dash-field dash-field-sm">
                            <span class="dash-field-ico" aria-hidden="true"><%- icon('search') %></span>
                            <input id="recent-search" class="dash-input" type="search" autocomplete="off"
                                   placeholder="جستجو در جلسات…" aria-label="جستجو در جلسات اخیر"/>
                        </div>
                        <a class="dash-link" id="recent-all-link" href="<%- url('meetings') %>" data-no-loader>
                            <span>نمایش همه</span>
                            <%- icon('arrow_forward') %>
                        </a>
                    </div>
                </div>

                <div id="recent-grid" class="dash-recent-grid">
                    <% if (recent.length === 0) { %>
                    <div class="dash-empty" id="recent-empty">
                        <span class="dash-empty-ico"><%- icon('calendar_add_on') %></span>
                        <p class="dash-empty-title">هنوز جلسه‌ای ایجاد نکرده‌ای</p>
                        <p class="dash-empty-sub">اولین تماس خودت را بساز و لینکش را با دوستانت به اشتراک بگذار.</p>
                        <% if (canCreate) { %>
                        <a class="dash-btn dash-btn-soft" href="<%- url('create') %>" data-no-loader>
                            <%- icon('video_call') %><span>ایجاد تماس</span>
                        </a>
                        <% } %>
                    </div>
                    <% } else { recent.forEach(function (m) { %>
                    <article class="dash-mcard<%- m.active ? ' is-live' : '' %>" data-recent-card
                             data-active="<%- m.active ? 1 : 0 %>"
                             data-created="<%- esc(String(m.created_at || '').slice(0, 7)) %>"
                             data-title="<%- esc(String(m.title || '').toLowerCase()) %>">
                        <div class="dash-mcard-top">
                            <span class="dash-mcard-ico"><%- icon('video_library') %></span>
                            <span class="dash-mcard-right">
                                <% if (m.active) { %>
                                <span class="dash-tag dash-tag-live"><span class="dash-live-dot" aria-hidden="true"></span> در حال اجرا</span>
                                <% } else { %>
                                <span class="dash-tag">پایان‌یافته</span>
                                <% } %>
                            </span>
                        </div>
                        <h3 class="dash-mcard-title" title="<%- esc(m.title) %>"><%- esc(m.title) %></h3>
                        <p class="dash-mcard-meta">
                            <%- icon('groups') %><span><%- toFaDigits(Number(m.members) || 0) %> عضو</span>
                            <span class="dash-dot-sep" aria-hidden="true"></span>
                            <span><%- esc(timeAgo(m.created_at)) %></span>
                        </p>
                        <div class="dash-mcard-foot">
                            <span class="dash-mcard-room" dir="ltr"><%- esc(String(m.room_id || '').slice(0, 8)) %>…</span>
                            <span class="dash-mcard-actions">
                                <% if (m.active) { %>
                                <button type="button" class="dash-mini" data-no-loader onclick="copyMeetLink(this)"
                                        data-link="<%- esc(public + '/meeting?room=' + encodeURIComponent(m.room_id)) %>"
                                        title="کپی لینک تماس" aria-label="کپی لینک تماس">
                                    <%- icon('link') %>
                                </button>
                                <a class="dash-mini dash-mini-open" href="<%- url('meeting') %>?room=<%- encodeURIComponent(m.room_id) %>"
                                   title="ورود به تماس">
                                    <%- icon('login') %>
                                </a>
                                <% } %>
                                <button type="button" class="dash-mini dash-mini-danger" data-no-loader
                                        onclick="deleteRecent(<%- Number(m.id) %>, this)"
                                        title="حذف دائمی جلسه" aria-label="حذف دائمی جلسه">
                                    <%- icon('close') %>
                                </button>
                            </span>
                        </div>
                    </article>
                    <% }); } %>
                </div>

                <div class="dash-nomatch" id="recent-nomatch" hidden>
                    <%- icon('search') %>
                    <span>جلسه‌ای با این عنوان پیدا نشد.</span>
                </div>

                <template id="recent-empty-tpl">
                    <div class="dash-empty" id="recent-empty">
                        <span class="dash-empty-ico"><%- icon('calendar_add_on') %></span>
                        <p class="dash-empty-title">هنوز جلسه‌ای ایجاد نکرده‌ای</p>
                        <p class="dash-empty-sub">اولین تماس خودت را بساز و لینکش را با دوستانت به اشتراک بگذار.</p>
                        <a class="dash-btn dash-btn-soft" href="<%- url('create') %>" data-no-loader>
                            <%- icon('video_call') %><span>ایجاد تماس</span>
                        </a>
                    </div>
                </template>
            </section>

            <aside class="dash-card dash-rail" aria-labelledby="dash-announce-title">
                <div class="dash-card-head dash-card-head-tight">
                    <span class="dash-card-ico dash-card-ico-mint"><%- icon('campaign') %></span>
                    <div>
                        <h2 class="dash-card-title" id="dash-announce-title">پیام‌های عمومی</h2>
                        <p class="dash-card-sub">اطلاعیه‌های مدیر سامانه</p>
                    </div>
                    <button type="button" class="dash-iconbtn dash-iconbtn-sm dash-rail-more" data-no-loader data-notif-open
                            onclick="toggleNotifications()" title="همه پیام‌ها" aria-label="همه پیام‌های عمومی">
                        <%- icon('more_vert') %>
                    </button>
                </div>

                <div id="dash-announce" class="dash-announce" aria-live="polite" aria-busy="true">
                    <div class="dash-announce-skel"><i></i><i></i><i></i></div>
                </div>
            </aside>
        </div>

        <p class="dash-foot-note">
            <%- icon('lock') %>
            <span>تماس‌ها فقط با تایید میزبان باز می‌شوند.</span>
        </p>
    </main>
</div>

<!-- ================= User menu ================= -->
<div id="user-menu" class="dash-pop dash-menu hidden" role="menu" aria-label="منوی حساب کاربری">
    <div class="dash-menu-head">
        <span class="dash-avatar" style="background:<%- esc(me.avatar_color) %>"><% if (me.avatar) { %><img src="<%- esc(avatarUrl(me.avatar)) %>" alt=""/><% } else { %><%- esc(initials) %><% } %></span>
        <span class="dash-menu-id">
            <span class="dash-menu-name"><%- esc(me.display_name) %></span>
            <span class="dash-menu-mail" dir="ltr"><%- esc(me.email) %></span>
        </span>
    </div>
    <div class="dash-menu-items">
        <a class="dash-menu-item" role="menuitem" href="<%- url('profile') %>">
            <%- icon('person') %><span>پروفایل</span>
        </a>
        <a class="dash-menu-item" role="menuitem" href="<%- url('create') %>">
            <%- icon('video_call') %><span>تماس جدید</span>
        </a>
        <% if (isManager || canMessages) { %>
        <a class="dash-menu-item" role="menuitem" href="<%- canMessagesHref %>">
            <%- icon('forum') %><span><%- isManager ? 'پیام‌ها' : 'ارتباط با ادمین' %></span>
        </a>
        <% } %>
        <% if (canMembers || canRequests) { %>
        <a class="dash-menu-item" role="menuitem" href="<%- url('members') %>">
            <%- icon('groups') %><span>مدیریت اعضا</span>
        </a>
        <% } %>
        <button type="button" class="dash-menu-item is-danger" role="menuitem" data-no-loader
                onclick="bmCloseUserMenu();logout(event)">
            <%- icon('logout') %><span>خروج از حساب</span>
        </button>
    </div>
</div>

<!-- ================= Notifications popup ================= -->
<div id="notif-popup" class="dash-pop hidden fixed" role="dialog" aria-modal="false" aria-labelledby="notif-title">
    <div class="dash-pop-head">
        <h3 class="dash-pop-title" id="notif-title">پیام‌های عمومی</h3>
        <button type="button" class="dash-iconbtn dash-iconbtn-sm" data-no-loader
                onclick="toggleNotifications()" aria-label="بستن"><%- icon('close') %></button>
    </div>
    <div class="dash-pop-sort">
        <span class="dash-pop-sort-label">مرتب‌سازی</span>
        <div class="dash-seg" role="group" aria-label="مرتب‌سازی پیام‌ها">
            <button id="sort-new" type="button" class="dash-seg-btn is-on" data-no-loader onclick="setNotifSort('new')">جدید</button>
            <button id="sort-old" type="button" class="dash-seg-btn" data-no-loader onclick="setNotifSort('old')">قدیمی</button>
        </div>
    </div>
    <div id="notif-list" class="dash-pop-list custom-scrollbar"></div>
</div>

<!-- ================= Confirm dialog ================= -->
<div id="bm-confirm" class="dash-modal hidden" role="dialog" aria-modal="true" aria-labelledby="bm-confirm-title" aria-describedby="bm-confirm-body">
    <div class="dash-modal-backdrop" data-confirm-cancel></div>
    <div class="dash-modal-box" role="document">
        <span class="dash-modal-ico" id="bm-confirm-ico"><%- icon('close') %></span>
        <h2 class="dash-modal-title" id="bm-confirm-title">حذف جلسه</h2>
        <p class="dash-modal-body" id="bm-confirm-body">این کار برگشت‌پذیر نیست.</p>
        <div class="dash-modal-actions">
            <button type="button" class="dash-btn dash-btn-ghost" id="bm-confirm-no" data-no-loader>انصراف</button>
            <button type="button" class="dash-btn dash-btn-danger" id="bm-confirm-yes" data-no-loader>حذف کن</button>
        </div>
    </div>
</div>

<!-- ================= Toast ================= -->
<div id="bm-toast" class="dash-toast" role="status" aria-live="polite" hidden>
    <span class="dash-toast-ico" id="bm-toast-ico"><%- icon('check_circle') %></span>
    <span class="dash-toast-msg" id="bm-toast-msg"></span>
    <button type="button" class="dash-toast-x" data-no-loader aria-label="بستن" onclick="bmToastHide()">
        <%- icon('close') %>
    </button>
</div>

<!-- ================= Mobile bottom nav ================= -->
<nav class="dash-bottomnav" aria-label="ناوبری پایین">
    <a class="dash-bn-item is-active" href="<%- url('home') %>" aria-current="page">
        <%- icon('home', '', true) %><span>خانه</span>
    </a>
    <% if (canCreate) { %>
    <a class="dash-bn-item" href="<%- url('create') %>">
        <%- icon('video_call') %><span>تماس</span>
    </a>
    <% } else { %>
    <button type="button" class="dash-bn-item" data-no-loader
            onclick="bmToast(<%- json(limited ? 'حساب شما محدود شده است' : 'سقف تماس امروز پر شده است') %>, 'error')">
        <%- icon('video_call') %><span>تماس</span>
    </button>
    <% } %>
    <% if (isManager || canMessages) { %>
    <a class="dash-bn-item" href="<%- canMessagesHref %>">
        <span class="dash-bn-ico-wrap"><%- icon('forum') %><span class="dash-bn-badge hidden" data-msg-badge>0</span></span>
        <span><%- isManager ? 'پیام‌ها' : 'ادمین' %></span>
    </a>
    <% } %>
    <a class="dash-bn-item" href="<%- url('profile') %>">
        <%- icon('person') %><span>پروفایل</span>
    </a>
    <button type="button" class="dash-bn-item" data-no-loader data-drawer-open aria-label="بیشتر">
        <%- icon('more_vert') %><span>بیشتر</span>
    </button>
</nav>

<script>
window.CSRF = <%- json(csrf) %>;
window.BASE = <%- json(base) %>;
window.__isManager = <%- json(isManager) %>;
window.MS_ID = <%- Number(me.id) %>;
window.BM_PUBLIC = <%- json(public) %>;
</script>
<script src="<%- asset('assets/js/dashboard.js') %>"></script>
<script src="<%- asset('assets/js/home.js') %>"></script>
</body>
</html>
