<%- include('head.ejs') %>
<link rel="stylesheet" href="<%- asset('assets/css/dashboard.css') %>"/>
</head>
<body class="bm-dash font-body-md msg-page">

<!-- ambient background (pure CSS, no image) -->
<div class="dash-ambient" aria-hidden="true">
    <span class="dash-ambient-glow"></span>
    <span class="dash-ambient-grid"></span>
</div>

<a class="dash-skip" href="#msg-main">پرش به محتوای اصلی</a>

<!-- ================= Desktop sidebar ================= -->
<aside class="dash-sidebar" aria-label="منوی کناری">
    <%- include('dash_sidebar', { drawer: false, activePage: 'messages' }) %>
</aside>

<!-- ================= Mobile drawer ================= -->
<div id="dash-drawer" class="dash-drawer" aria-hidden="true">
    <div class="dash-drawer-backdrop" data-drawer-close></div>
    <div class="dash-drawer-panel" role="dialog" aria-modal="true" aria-label="منوی موبایل">
        <%- include('dash_sidebar', { drawer: true, activePage: 'messages' }) %>
    </div>
</div>

<!-- ================= Shell ================= -->
<div class="dash-shell msg-shell">

    <header class="dash-header" id="dash-header">
        <button type="button" class="dash-iconbtn dash-burger" data-no-loader data-drawer-open
                aria-label="باز کردن منو" aria-controls="dash-drawer" aria-expanded="false">
            <%- icon('menu') %>
        </button>

        <a class="dash-header-brand" href="<%- url('home') %>" aria-label="Black Meet — خانه">
            <%- brandMark('dash-header-brand-img') %>
            <span>Black Meet</span>
        </a>

        <span class="dash-crumb" aria-hidden="true">
            <span class="dash-crumb-home">خانه</span>
            <span class="dash-crumb-sep">/</span>
            <span class="dash-crumb-cur"><%- isManager ? 'پیام‌ها' : 'ارتباط با ادمین' %></span>
        </span>

        <div class="dash-header-spacer"></div>

        <a class="dash-iconbtn" href="<%- url('home') %>" aria-label="بازگشت به خانه" title="بازگشت به خانه">
            <%- icon('arrow_forward') %>
        </a>

        <button type="button" class="dash-header-user" data-no-loader data-user-menu-trigger
                aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" aria-label="منوی حساب کاربری">
            <span class="dash-avatar dash-avatar-sm" style="background:<%- esc(me.avatar_color) %>"><% if (me.avatar) { %><img src="<%- esc(avatarUrl(me.avatar)) %>" alt=""/><% } else { %><%- esc(initials) %><% } %></span>
            <span class="dash-header-user-name"><%- esc(me.display_name) %></span>
            <%- icon('more_vert', 'dash-header-user-more') %>
        </button>
    </header>

    <main id="msg-main" class="msg-main">
        <!-- conversation list -->
        <aside class="conv-panel msg-side" aria-label="گفتگوها">
            <div class="msg-side-head">
                <div class="msg-side-title-row">
                    <span class="dash-card-ico dash-card-ico-accent"><%- icon('forum') %></span>
                    <div>
                        <h1 class="dash-card-title"><%- isManager ? 'پیام‌ها' : 'ارتباط با ادمین' %></h1>
                        <p class="dash-card-sub"><%- isManager ? 'گفتگو با کاربران' : 'گفتگوی خصوصی با مدیر' %></p>
                    </div>
                </div>
                <div class="dash-field dash-field-sm msg-search <%- isManager ? '' : 'hidden' %>">
                    <span class="dash-field-ico" aria-hidden="true"><%- icon('search') %></span>
                    <input id="conv-search" class="dash-input bm-search" type="search" autocomplete="off"
                           placeholder="جستجوی کاربر..." aria-label="جستجوی کاربر" oninput="filterConvs()"/>
                </div>
            </div>
            <div id="conv-list" class="msg-conv-list custom-scrollbar"></div>
        </aside>

        <!-- conversation -->
        <section class="chat-panel msg-chat" aria-label="گفتگو">
            <div id="profile-header" class="msg-chat-head hidden" onclick="openProfileModal()">
                <button id="chat-back" data-no-loader onclick="backToConvs(event)" class="dash-iconbtn dash-iconbtn-sm md:hidden" aria-label="بازگشت به گفتگوها"><%- icon('arrow_forward') %></button>
                <div id="ph-avatar" class="msg-chat-avatar"></div>
                <div class="min-w-0">
                    <h3 id="ph-name" class="msg-chat-name truncate"></h3>
                    <p id="ph-status" class="msg-chat-status"></p>
                </div>
            </div>

            <div id="chat-area" class="msg-chat-body custom-scrollbar">
                <div class="dash-chat-empty">
                    <span class="dash-chat-empty-ico"><%- icon('forum') %></span>
                    <p class="dash-chat-empty-title">یک گفتگو را انتخاب کنید</p>
                    <p class="dash-chat-empty-sub">پیام‌های عمومی و گفتگوهای خصوصی اینجا نمایش داده می‌شوند.</p>
                </div>
            </div>

            <div class="msg-inputbar">
                <div class="msg-inputrow">
                    <input id="msg-input" class="dash-input" type="text" autocomplete="off"
                           placeholder="پیام خود را بنویسید..." aria-label="متن پیام"
                           onkeydown="if(event.key==='Enter')sendMessage()"/>
                    <button type="button" class="dash-btn dash-btn-solid msg-send" onclick="sendMessage()" aria-label="ارسال پیام">
                        <%- icon('send') %>
                    </button>
                </div>
            </div>
        </section>
    </main>
</div>

<!-- Profile modal -->
<div id="profile-modal" class="dash-modal hidden" role="dialog" aria-modal="true" aria-labelledby="pm-name" onclick="if(event.target===this)closeProfileModal()">
    <div class="dash-modal-backdrop" onclick="closeProfileModal()"></div>
    <div class="dash-modal-box" role="document">
        <button type="button" class="dash-iconbtn dash-iconbtn-sm dash-modal-x" onclick="closeProfileModal()" aria-label="بستن"><%- icon('close') %></button>
        <div id="pm-avatar" class="msg-profile-avatar"></div>
        <h3 id="pm-name" class="dash-modal-title"></h3>
        <p id="pm-username" class="dash-hint" dir="ltr"></p>
        <p id="pm-email" class="dash-hint" dir="ltr"></p>
    </div>
</div>

<%- include('dash_usermenu') %>
<%- include('dash_confirm') %>
<%- include('dash_toast') %>

<style>
/* mobile: list and chat take the full width, one at a time */
@media (max-width: 767px) {
  #msg-main .conv-panel { width: 100%; }
  #msg-main.chat-open .conv-panel { display: none; }
  #msg-main:not(.chat-open) .chat-panel { display: none; }
}
</style>

<script>
window.CSRF = <%- json(csrf) %>;
window.BASE = <%- json(base) %>;
window.__IS_MANAGER = <%- json(isManager) %>;
window.__isManager = <%- json(isManager) %>;
window.MS_ID = <%- Number(me.id) %>;
window.MS_USERNAME = <%- json(me.username) %>;
</script>
<script src="<%- asset('assets/js/dashboard.js') %>"></script>
<script src="<%- asset('assets/js/messages.js') %>"></script>
</body>
</html>
