<%- include('head.ejs') %>
<link rel="stylesheet" href="<%- asset('assets/css/dashboard.css') %>"/>
</head>
<body class="bm-auth font-body-md">

<!-- ambient background (pure CSS) -->
<div class="dash-ambient" aria-hidden="true">
    <span class="dash-ambient-glow"></span>
    <span class="dash-ambient-grid"></span>
</div>

<a class="dash-skip" href="#forgot-card">پرش به فرم بازیابی</a>

<div class="auth-shell">

    <!-- ================= brand aside (desktop) ================= -->
    <aside class="auth-aside" aria-label="درباره بازیابی حساب">
        <a class="auth-aside-brand" href="<%- url('login') %>" aria-label="Black Meet">
            <%- brandMark('bm-brand-mark') %>
            <span class="auth-aside-name">Black Meet</span>
        </a>

        <div class="auth-aside-body">
            <p class="auth-eyebrow"><%- icon('help') %><span>بازیابی حساب</span></p>

            <h1 class="auth-headline">
                رمز را فراموش کرده‌اید؟<br/>
                با مدیر گفتگو کنید
            </h1>

            <p class="auth-lede">
                شماره تلفن یا ایمیل حساب خود را وارد کنید. پیام‌هایی که با مدیر رد و بدل می‌کنید
                در همین صفحه نمایش داده می‌شوند و نیازی به ایمیل نیست.
            </p>

            <ul class="auth-points">
                <li>
                    <span class="auth-point-ico"><%- icon('forum') %></span>
                    <span>گفتگو با مدیر، مستقیم و در همین صفحه.</span>
                </li>
                <li>
                    <span class="auth-point-ico"><%- icon('lock') %></span>
                    <span>برای باز کردن گفتگو باید شماره یا ایمیل حساب را بدانید.</span>
                </li>
                <li>
                    <span class="auth-point-ico"><%- icon('check_circle') %></span>
                    <span>پاسخ مدیر بدون رفرش صفحه به شما نشان داده می‌شود.</span>
                </li>
            </ul>
        </div>

        <p class="auth-aside-foot">اگر حساب ندارید، از صفحهٔ ورود ثبت‌نام کنید.</p>
    </aside>

    <!-- ================= auth panel ================= -->
    <div class="auth-panel">

        <div class="auth-panel-brand">
            <%- brandMark('bm-brand-mark') %>
            <span class="auth-panel-brand-text">
                <span class="auth-panel-brand-name">Black Meet</span>
                <span class="auth-panel-brand-sub">بازیابی حساب</span>
            </span>
        </div>

        <div class="auth-card glass-panel" id="forgot-card">

            <!-- ================= identify ================= -->
            <div class="view" id="identify-box">
                <div class="auth-head">
                    <a class="auth-back" href="<%- url('login') %>" data-no-loader aria-label="بازگشت به ورود">
                        <%- icon('arrow_forward') %>
                    </a>
                    <h1 class="auth-title">بازیابی رمز عبور</h1>
                    <button type="button" id="help-btn" class="auth-back relative help-bounce" aria-label="راهنمای بازیابی"
                            title="راهنما">
                        <%- icon('help') %>
                    </button>
                </div>

                <p class="auth-sub">
                    شماره تلفن یا ایمیل خود را وارد کنید تا پیام‌های شما با مدیر نمایش داده شود.
                </p>

                <label class="auth-label" for="identifier">شماره تلفن یا ایمیل</label>
                <div class="dash-field">
                    <span class="dash-field-ico" aria-hidden="true"><%- icon('person') %></span>
                    <input id="identifier" class="dash-input" dir="ltr" type="text"
                           placeholder="09xxxxxxxxx یا you@example.com" autocomplete="username" spellcheck="false"/>
                </div>

                <button type="button" class="dash-btn dash-btn-solid dash-btn-lg" data-no-loader onclick="openThread()">
                    <%- icon('forum') %><span>مشاهده پیام‌ها</span>
                </button>

                <p class="auth-note">
                    <%- icon('lock') %>
                    <span>رمز عبور را در این صفحه وارد نکنید؛ فقط شناسهٔ حساب برای باز کردن گفتگو لازم است.</span>
                </p>
            </div>

            <!-- ================= thread ================= -->
            <div id="thread-box" class="hidden auth-thread">
                <div class="auth-head">
                    <span class="auth-state-ico auth-state-ico-sm"><%- icon('forum') %></span>
                    <h2 class="auth-title">گفتگو با مدیر</h2>
                    <button type="button" class="auth-thread-close" data-no-loader onclick="closeThread()">بستن</button>
                </div>

                <div id="pv-messages" class="auth-thread-box custom-scrollbar" role="log" aria-live="polite"></div>

                <div class="auth-inputrow">
                    <input id="pv-input" class="dash-input dash-input-plain" placeholder="پیام خود را بنویسید…"
                           aria-label="متن پیام" onkeydown="if(event.key==='Enter')sendPv()"/>
                    <button type="button" class="dash-btn dash-btn-solid auth-send" data-no-loader
                            onclick="sendPv()" aria-label="ارسال پیام">
                        <%- icon('send') %>
                    </button>
                </div>

                <p class="auth-sub auth-sub-tight">پیام‌ها هر چند لحظه یک‌بار به‌روز می‌شوند.</p>
            </div>
        </div>

        <p class="auth-foot">
            <%- icon('lock') %>
            <span>این گفتگو فقط برای هماهنگی با مدیر است.</span>
        </p>
    </div>
</div>

<!-- Help modal -->
<div id="help-modal" class="hidden fixed inset-0 z-[80] flex items-center justify-center bg-background/70 backdrop-blur-sm p-4"
     role="dialog" aria-modal="true" aria-labelledby="help-title">
    <div class="auth-card glass-panel" style="max-width:460px">
        <div class="auth-head">
            <span class="auth-state-ico auth-state-ico-sm"><%- icon('help') %></span>
            <h3 class="auth-title" id="help-title">راهنمای بازیابی رمز عبور</h3>
            <button type="button" class="auth-back" aria-label="بستن" onclick="closeHelp()"><%- icon('close') %></button>
        </div>
        <p class="auth-sub auth-sub-start">
            برای بازیابی رمز عبور، لطفاً شماره تلفن، ایمیل و نام کاربری خود را برای مدیر ارسال کنید.
            پاسخ مدیر در همین صفحه برای شما نمایش داده می‌شود. لطفاً از ارسال پیام‌های غیرضروری خودداری کنید.
        </p>
    </div>
</div>

<div class="fixed bottom-6 right-6 hidden z-50" id="toast" role="alert" aria-live="assertive"><div class="px-6 py-3 rounded-lg shadow-xl flex items-center gap-3">
    <%- icon('error') %><span id="toast-message"></span></div></div>

<style>
.help-bounce { animation: helpBounce 1.4s ease-in-out infinite; }
@keyframes helpBounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
@media (prefers-reduced-motion: reduce) { .help-bounce { animation: none; } }
</style>

<script>window.CSRF = <%- json(csrf) %>; window.BASE = <%- json(base) %>;</script>
<script src="<%- url('assets/js/forgot_password.js') %>"></script>
</body>
</html>
