<%- include('head.ejs') %>
<link rel="stylesheet" href="<%- asset('assets/css/dashboard.css') %>"/>
</head>
<body class="bm-dash font-body-md">

<!-- ambient background (pure CSS, no image) -->
<div class="dash-ambient" aria-hidden="true">
    <span class="dash-ambient-glow"></span>
    <span class="dash-ambient-grid"></span>
</div>

<a class="dash-skip" href="#dash-main">پرش به محتوای اصلی</a>

<!-- ================= Desktop sidebar ================= -->
<aside class="dash-sidebar" aria-label="منوی کناری">
    <%- include('dash_sidebar', { drawer: false, activePage: 'create' }) %>
</aside>

<!-- ================= Mobile drawer ================= -->
<div id="dash-drawer" class="dash-drawer" aria-hidden="true">
    <div class="dash-drawer-backdrop" data-drawer-close></div>
    <div class="dash-drawer-panel" role="dialog" aria-modal="true" aria-label="منوی موبایل">
        <%- include('dash_sidebar', { drawer: true, activePage: 'create' }) %>
    </div>
</div>

<!-- ================= Shell ================= -->
<div class="dash-shell">

    <header class="dash-header" id="dash-header">
        <button type="button" class="dash-iconbtn dash-burger" data-no-loader data-drawer-open
                aria-label="باز کردن منو" aria-controls="dash-drawer" aria-expanded="false">
            <%- icon('menu') %>
        </button>

        <a class="dash-header-brand" href="<%- url('home') %>" aria-label="Black Meet — خانه">
            <%- brandMark('dash-header-brand-img') %>
            <span>Black Meet</span>
        </a>

        <span class="dash-crumb" aria-hidden="true">
            <span class="dash-crumb-home">خانه</span>
            <span class="dash-crumb-sep">/</span>
            <span class="dash-crumb-cur">تماس جدید</span>
        </span>

        <div class="dash-header-spacer"></div>

        <button type="button" class="dash-iconbtn dash-iconbtn-back" data-no-loader onclick="goBack()"
                title="بازگشت" aria-label="بازگشت به صفحه قبل">
            <%- icon('arrow_forward') %>
        </button>

        <button type="button" class="dash-header-user" data-no-loader data-user-menu-trigger
                aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" aria-label="منوی حساب کاربری">
            <span class="dash-avatar dash-avatar-sm" style="background:<%- esc(me.avatar_color) %>"><% if (me.avatar) { %><img src="<%- esc(avatarUrl(me.avatar)) %>" alt=""/><% } else { %><%- esc(initials) %><% } %></span>
            <span class="dash-header-user-name"><%- esc(me.display_name) %></span>
            <%- icon('more_vert', 'dash-header-user-more') %>
        </button>
    </header>

    <main class="dash-main dash-create" id="dash-main">

        <section class="dash-page-head">
            <p class="dash-page-eyebrow"><%- icon('video_call') %><span>شروع یک جلسه</span></p>
            <h1 class="dash-page-title">ایجاد تماس جدید</h1>
            <p class="dash-page-sub">
                یک عنوان بگذار، حالت ورود اعضا را انتخاب کن و بعد لینک اتاق را برای بقیه بفرست.
            </p>
        </section>

        <div class="create-grid">

            <!-- ---------------- form ---------------- -->
            <section class="dash-card" aria-labelledby="create-card-title">
                <div class="dash-card-head">
                    <span class="dash-card-ico dash-card-ico-accent"><%- icon('video_call') %></span>
                    <div>
                        <h2 class="dash-card-title" id="create-card-title">مشخصات جلسه</h2>
                        <p class="dash-card-sub">عنوان فقط برای خودت و مهمان‌ها نمایش داده می‌شود</p>
                    </div>
                </div>

                <label class="create-label" for="meeting-title">عنوان تماس</label>
                <div class="dash-field">
                    <span class="dash-field-ico" aria-hidden="true"><%- icon('edit') %></span>
                    <input id="meeting-title" class="dash-input create-title-input" type="text"
                           maxlength="120" autocomplete="off" spellcheck="false"
                           placeholder="مثال: جلسه هفتگی تیم" aria-describedby="create-hint"/>
                </div>
                <p class="dash-hint" id="create-hint">اگر عنوان را خالی بگذاری، یک نام پیش‌فرض برای جلسه ثبت می‌شود.</p>

                <!-- Media-default toggle: state 1 = arrive with mic+cam on; state 2 = arrive muted, admin can enable -->
                <div class="create-switch">
                    <div class="create-switch-main">
                        <span class="create-switch-ico"><%- icon('record_voice_over', '', true, 'id="media-icon"') %></span>
                        <div class="min-w-0">
                            <h3 id="media-title" class="create-switch-title">ورود با صدا و تصویر</h3>
                            <p id="media-hint" class="create-switch-hint">بعد از تایید ادمین، میکروفون و دوربین به‌صورت خودکار روشن می‌شوند</p>
                        </div>
                    </div>
                    <label class="bm-switch flex-shrink-0">
                        <input type="checkbox" id="default-media" checked/>
                        <span class="bm-switch-slider"></span>
                    </label>
                </div>

                <!-- "join without approval": off by default, so people still wait for the admin -->
                <div class="create-switch">
                    <div class="create-switch-main">
                        <span class="create-switch-ico create-switch-ico-alt"><%- icon('group', '', false, 'id="openjoin-icon"') %></span>
                        <div class="min-w-0">
                            <h3 class="create-switch-title">ورود بدون تایید ادمین</h3>
                            <p class="create-switch-hint" id="openjoin-hint">هر کسی که لینک تماس را داشته باشد مستقیم وارد می‌شود. اگر خاموش باشد، کاربران تا تایید شما منتظر می‌مانند.</p>
                        </div>
                    </div>
                    <label class="bm-switch flex-shrink-0">
                        <input type="checkbox" id="open-join"/>
                        <span class="bm-switch-slider"></span>
                    </label>
                </div>

                <% if (quotaText) { %>
                <div class="create-quota<%- quotaFull ? ' is-full' : '' %>">
                    <span class="create-quota-label"><%- icon('calendar_add_on') %> سقف تماس امروز شما</span>
                    <b><%- quotaText %></b>
                </div>
                <% } %>

                <% if (limited) { %>
                <div class="create-alert" role="alert">
                    <%- icon('block') %>
                    <span>حساب کاربری شما محدود شده است؛ امکان ایجاد تماس جدید وجود ندارد، فقط می‌توانید به تماس‌های دیگر بپیوندید.</span>
                </div>
                <% } else if (quotaFull) { %>
                <div class="create-alert" role="alert">
                    <%- icon('block') %>
                    <span>به سقف تماس امروز خود رسیده‌اید؛ فردا دوباره می‌توانید تماس جدید ایجاد کنید.</span>
                </div>
                <% } else if (!canCreate) { %>
                <div class="create-alert" role="alert">
                    <%- icon('block') %>
                    <span><%- esc(createBlockMsg) %></span>
                </div>
                <% } %>

                <div class="create-actions">
                    <button id="create-btn" class="dash-btn dash-btn-lg <%- !canCreate ? 'is-disabled' : 'dash-btn-primary' %>"
                            type="button" onclick="createMeeting()"
                            <%- !canCreate ? 'disabled aria-disabled="true"' : '' %>>
                        <%- icon('arrow_back') %><span class="dash-btn-label">ساخت تماس و ادامه</span>
                    </button>
                    <a class="dash-btn dash-btn-soft" href="<%- url('home') %>" data-no-loader>انصراف</a>
                </div>
            </section>

            <!-- ---------------- side rail ---------------- -->
            <aside class="create-side">
                <section class="dash-card" aria-labelledby="create-tips-title">
                    <div class="dash-card-head dash-card-head-tight">
                        <span class="dash-card-ico dash-card-ico-mint"><%- icon('check_circle') %></span>
                        <div>
                            <h2 class="dash-card-title" id="create-tips-title">قبل از شروع</h2>
                            <p class="dash-card-sub">سه نکته کوتاه برای یک جلسهٔ بی‌دردسر</p>
                        </div>
                    </div>
                    <ul class="create-tips">
                        <li><%- icon('link') %><span>لینک اتاق را بعد از ساخت، از صفحهٔ خانه یا «همهٔ تماس‌ها» کپی کنید.</span></li>
                        <li><%- icon('shield_person') %><span>تا وقتی «ورود بدون تایید» خاموش است، هر مهمان در صف انتظار می‌ماند و شما تایید می‌کنید.</span></li>
                        <li><%- icon('mic_off') %><span>اگر ورود بدون صدا را انتخاب کنید، مهمان‌ها بی‌صدا وارد می‌شوند و شما می‌توانید برایشان روشن کنید.</span></li>
                    </ul>
                </section>

                <section class="dash-card" aria-labelledby="create-privacy-title">
                    <div class="dash-card-head dash-card-head-tight">
                        <span class="dash-card-ico"><%- icon('lock') %></span>
                        <div>
                            <h2 class="dash-card-title" id="create-privacy-title">حریم خصوصی</h2>
                            <p class="dash-card-sub">اتاق فقط با لینک باز می‌شود</p>
                        </div>
                    </div>
                    <p class="dash-hint">
                        هیچ تماسی در فهرست عمومی سایت نمایش داده نمی‌شود؛ فقط کسانی که لینک را دارند یا
                        از شما دعوت گرفته‌اند می‌توانند درخواست ورود بفرستند.
                    </p>
                </section>
            </aside>
        </div>

        <p class="dash-foot-note">
            <%- icon('lock') %>
            <span>تماس‌ها فقط با تایید میزبان باز می‌شوند.</span>
        </p>
    </main>
</div>

<%- include('dash_usermenu') %>
<%- include('dash_confirm') %>
<%- include('dash_toast') %>
<%- include('dash_bottomnav', { activePage: 'create' }) %>

<script>
window.CSRF = <%- json(csrf) %>;
window.BASE = <%- json(base) %>;
</script>
<script src="<%- asset('assets/js/dashboard.js') %>"></script>
<script src="<%- asset('assets/js/create.js') %>"></script>
</body>
</html>
