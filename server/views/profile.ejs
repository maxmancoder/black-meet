<%- include('head.ejs') %>
<link rel="stylesheet" href="<%- asset('assets/css/dashboard.css') %>"/>
</head>
<%
  var keyCount = (isManager || canMessages ? 1 : 0) + (canMembers || canRequests ? 1 : 0);
%>
<body class="bm-dash font-body-md">

<!-- ambient background (pure CSS, no image) -->
<div class="dash-ambient" aria-hidden="true">
    <span class="dash-ambient-glow"></span>
    <span class="dash-ambient-grid"></span>
</div>

<a class="dash-skip" href="#dash-main">پرش به محتوای اصلی</a>

<!-- ================= Desktop sidebar ================= -->
<aside class="dash-sidebar" aria-label="منوی کناری">
    <%- include('dash_sidebar', { drawer: false, activePage: 'profile' }) %>
</aside>

<!-- ================= Mobile drawer ================= -->
<div id="dash-drawer" class="dash-drawer" aria-hidden="true">
    <div class="dash-drawer-backdrop" data-drawer-close></div>
    <div class="dash-drawer-panel" role="dialog" aria-modal="true" aria-label="منوی موبایل">
        <%- include('dash_sidebar', { drawer: true, activePage: 'profile' }) %>
    </div>
</div>

<!-- ================= Shell ================= -->
<div class="dash-shell">

    <header class="dash-header" id="dash-header">
        <button type="button" class="dash-iconbtn dash-burger" data-no-loader data-drawer-open
                aria-label="باز کردن منو" aria-controls="dash-drawer" aria-expanded="false">
            <%- icon('menu') %>
        </button>

        <a class="dash-header-brand" href="<%- url('home') %>" aria-label="Black Meet — خانه">
            <%- brandMark('dash-header-brand-img') %>
            <span>Black Meet</span>
        </a>

        <span class="dash-crumb" aria-hidden="true">
            <span class="dash-crumb-home">خانه</span>
            <span class="dash-crumb-sep">/</span>
            <span class="dash-crumb-cur">پروفایل</span>
        </span>

        <div class="dash-header-spacer"></div>

        <a class="dash-iconbtn" href="<%- url('home') %>" aria-label="بازگشت به خانه" title="بازگشت به خانه">
            <%- icon('arrow_forward') %>
        </a>

        <button type="button" class="dash-header-user" data-no-loader data-user-menu-trigger
                aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" aria-label="منوی حساب کاربری">
            <span class="dash-avatar dash-avatar-sm" style="background:<%- esc(me.avatar_color) %>"><% if (me.avatar) { %><img src="<%- esc(avatarUrl(me.avatar)) %>" alt=""/><% } else { %><%- esc(initials) %><% } %></span>
            <span class="dash-header-user-name"><%- esc(me.display_name) %></span>
            <%- icon('more_vert', 'dash-header-user-more') %>
        </button>
    </header>

    <main class="dash-main dash-profile" id="dash-main">

        <section class="dash-page-head">
            <p class="dash-page-eyebrow"><%- icon('person') %><span>حساب کاربری</span></p>
            <h1 class="dash-page-title">پروفایل من</h1>
            <p class="dash-page-sub">تصویر، نام نمایشی و اطلاعات حساب خود را ببینید و مدیریت کنید.</p>
        </section>

        <!-- identity -->
        <section class="dash-card dash-profile-hero" aria-labelledby="profile-name">
            <div class="dash-profile-avatar" style="background:<%- esc(me.avatar_color) %>">
                <% if (av) { %><img src="<%- esc(av) %>" alt="تصویر پروفایل"/><% } else { %><%- esc(initials) %><% } %>
            </div>
            <div class="dash-profile-id">
                <div class="dash-profile-name-row">
                    <h2 class="dash-profile-name" id="profile-name"><%- esc(me.display_name) %></h2>
                    <% if (me.is_manager) { %>
                    <span class="dash-pill dash-pill-rank"><%- icon('shield_person', '', true) %><%- rankLabel %></span>
                    <% } else if (rankLabel !== 'کاربر عادی') { %>
                    <span class="dash-pill"><%- icon('shield_person', '', true) %><%- rankLabel %></span>
                    <% } %>
                </div>
                <p class="dash-profile-handle" dir="ltr">@<%- esc(me.username) %></p>

                <div class="dash-profile-avatar-key">
                    <input id="avatar-input" type="file" accept="image/*" class="hidden" onchange="uploadAvatar()"/>
                    <button type="button" class="dash-btn dash-btn-soft" data-no-loader
                            onclick="document.getElementById('avatar-input').click()">
                        <%- icon('upload') %><span>تغییر تصویر پروفایل</span>
                    </button>
                    <p class="dash-hint">فرمت‌های مجاز تصویر (حداکثر ۲ مگابایت).</p>
                </div>
            </div>
        </section>

        <!-- Mobile quick keys: پیام‌ها / مدیریت اعضا (gated by rank) -->
        <% if (isManager || canMessages || canMembers || canRequests) { %>
        <div class="md:hidden grid <%= keyCount === 2 ? 'grid-cols-2' : 'grid-cols-1' %> gap-3" id="mobile-profile-keys">
            <% if (isManager || canMessages) { %>
            <a id="key-messages" href="<%- url('messages') %><%- isManager ? '' : '?chat=admin' %>" class="group flex flex-col items-center justify-center gap-2.5 rounded-2xl border border-primary/30 bg-gradient-to-b from-primary-container/45 to-surface-container-high/70 px-3 py-5 text-on-surface shadow-lg shadow-black/20 active:scale-95 transition">
                <span class="w-12 h-12 rounded-2xl bg-primary-container text-on-primary-container flex items-center justify-center shadow-md shadow-primary/25 group-hover:shadow-primary/50 transition"><%- icon('forum', 'text-[24px]', true) %></span>
                <span class="font-label-md leading-tight">پیام‌ها</span>
                <span class="font-body-sm text-[11px] text-on-surface-variant -mt-1">گفتگوها و اعلان‌ها</span>
            </a>
            <% } %>
            <% if (canMembers || canRequests) { %>
            <a id="key-members" href="<%- url('members') %>" class="group flex flex-col items-center justify-center gap-2.5 rounded-2xl border border-secondary/30 bg-gradient-to-b from-secondary-container/45 to-surface-container-high/70 px-3 py-5 text-on-surface shadow-lg shadow-black/20 active:scale-95 transition">
                <span class="w-12 h-12 rounded-2xl bg-secondary-container text-on-secondary-container flex items-center justify-center shadow-md shadow-secondary/25 group-hover:shadow-secondary/50 transition"><%- icon('group', 'text-[24px]', true) %></span>
                <span class="font-label-md leading-tight">مدیریت اعضا</span>
                <span class="font-body-sm text-[11px] text-on-surface-variant -mt-1">اعضا و درخواست‌ها</span>
            </a>
            <% } %>
        </div>
        <% } %>

        <!-- account information -->
        <section class="dash-card" aria-labelledby="dash-info-title">
            <div class="dash-card-head">
                <span class="dash-card-ico dash-card-ico-accent"><%- icon('badge') %></span>
                <div>
                    <h2 class="dash-card-title" id="dash-info-title">اطلاعات حساب</h2>
                    <p class="dash-card-sub">این اطلاعات را فقط خودتان و مدیر سامانه می‌بینید.</p>
                </div>
            </div>

            <div class="dash-info-grid">
                <div class="bm-infobox"><span class="bm-infobox-title">نام کامل</span><span class="bm-infobox-val"><%- esc(me.full_name) %></span></div>
                <div class="bm-infobox"><span class="bm-infobox-title">نام کاربری</span><span class="bm-infobox-val" dir="ltr">@<%- esc(me.username) %></span></div>
                <!-- the editor slides out DIRECTLY under the display-name box; it is inside the same grid
                     cell so it can never drift to another column -->
                <div class="bm-dn-cell">
                    <div class="bm-infobox bm-dn-host">
                        <span class="bm-infobox-title">نام نمایشی</span>
                        <span class="bm-infobox-val" id="dn-current"><%- esc(me.display_name) %></span>
                        <button type="button" id="btn-edit-name" onclick="toggleDisplayNameEditor(true)"
                                class="bm-dn-key mt-2" aria-controls="dn-panel" aria-expanded="false">
                            <%- icon('edit', 'text-[14px]', false, 'id="dn-key-icon"') %>
                            <span id="dn-key-label">تغییر نام نمایشی</span>
                        </button>
                    </div>
                    <div id="dn-panel" class="bm-dn-panel" aria-hidden="true">
                        <div class="bm-infobox bm-dn-inner">
                            <input id="display-name" type="text" maxlength="40" value="<%- esc(me.display_name) %>"
                                   class="dash-input w-full" dir="rtl"/>
                            <p id="display-name-hint" class="dash-hint">هر روز یک‌بار قابل تغییر است.</p>
                            <div class="dash-dn-actions">
                                <button type="button" onclick="saveProfile()" id="btn-save-name" class="dash-btn dash-btn-solid">ذخیره</button>
                                <button type="button" onclick="toggleDisplayNameEditor(false)" id="btn-cancel-name" class="dash-btn dash-btn-ghost">لغو</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bm-infobox"><span class="bm-infobox-title">ایمیل</span><span class="bm-infobox-val" dir="ltr"><%- esc(me.email) %></span></div>
                <div class="bm-infobox"><span class="bm-infobox-title">رمز عبور</span><span class="bm-infobox-val"><%- icon('lock', 'text-[16px] align-middle', true) %> ****************</span></div>
                <div class="bm-infobox"><span class="bm-infobox-title">شماره موبایل</span><span class="bm-infobox-val" dir="ltr"><%- esc(me.phone) %></span></div>
                <div class="bm-infobox"><span class="bm-infobox-title">نقش</span><span class="bm-infobox-val"><%- rankLabel %></span></div>
            </div>

            <div class="dash-note">
                <%- icon('lock') %>
                <span>برای تغییر رمز عبور به ادمین پیام دهید!</span>
            </div>
        </section>

        <% if (me.is_manager) { %>
        <!-- Manager's extra key card -->
        <section class="bm-adminkey dash-adminkey">
            <div class="dash-adminkey-main">
                <span class="dash-adminkey-ico"><%- icon('key', '', true) %></span>
                <div class="min-w-0">
                    <p class="dash-adminkey-title">کلید مدیر <span>(دسترسی ویژه)</span></p>
                    <p class="dash-adminkey-sub">شما به‌عنوان مدیر، کلید مدیریت اعضا و پیام‌ها را در اختیار دارید.</p>
                </div>
            </div>
            <a href="<%- url('members') %>" class="dash-btn dash-btn-admin">
                <%- icon('shield_person', '', true) %><span>مدیریت اعضا</span>
            </a>
        </section>

        <!-- the site icon: it is stored in the database and used everywhere -->
        <section class="dash-card dash-siteicon" aria-labelledby="dash-siteicon-title">
            <img id="site-icon-preview" src="<%- siteIconUrl() %>" alt="آیکون سایت" class="dash-siteicon-preview"/>
            <div class="min-w-0 flex-1">
                <h2 class="dash-card-title" id="dash-siteicon-title">آیکون سایت</h2>
                <p class="dash-card-sub">این آیکون در دیتابیس ذخیره می‌شود و در همهٔ صفحه‌ها (نشان مرورگر، سربرگ، صفحهٔ ورود) نمایش داده می‌شود.</p>
                <div class="bm-keyrow mt-3">
                    <button type="button" onclick="document.getElementById('site-icon-input').click()" class="dash-btn dash-btn-soft">انتخاب تصویر جدید</button>
                    <button type="button" onclick="resetSiteIcon()" class="dash-btn dash-btn-ghost">بازگشت به پیش‌فرض</button>
                    <input id="site-icon-input" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" class="hidden" onchange="uploadSiteIcon(this)"/>
                    <span class="dash-hint">PNG یا JPG، حداکثر ۲ مگابایت</span>
                </div>
            </div>
        </section>
        <% } %>
    </main>
</div>

<!-- Avatar upload progress -->
<div id="av-progress" class="hidden fixed inset-0 z-[90] flex items-center justify-center bg-background/70 backdrop-blur-sm p-4">
    <div class="dash-modal-box">
        <div id="av-prog-pct" class="dash-av-pct">۰٪</div>
        <div class="dash-meter mb-3"><span id="av-prog-bar" style="width:0%"></span></div>
        <p class="dash-hint text-center">در حال آپلود تصویر پروفایل...</p>
    </div>
</div>

<%- include('dash_usermenu') %>
<%- include('dash_confirm') %>
<%- include('dash_toast') %>
<%- include('dash_bottomnav', { activePage: 'profile' }) %>

<script>
window.CSRF = <%- json(csrf) %>;
window.BASE = <%- json(base) %>;
window.__isManager = <%- json(isManager) %>;
window.canMessages = <%- json(canMessages) %>;
</script>
<script src="<%- asset('assets/js/dashboard.js') %>"></script>
<script src="<%- asset('assets/js/profile.js') %>"></script>
</body>
</html>
