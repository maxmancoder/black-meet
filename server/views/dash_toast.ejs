<div id="bm-toast" class="dash-toast" role="status" aria-live="polite" hidden>
    <span class="dash-toast-ico" id="bm-toast-ico"><%- icon('check_circle') %></span>
    <span class="dash-toast-msg" id="bm-toast-msg"></span>
    <button type="button" class="dash-toast-x" data-no-loader aria-label="بستن" onclick="bmToastHide()">
        <%- icon('close') %>
    </button>
</div>
