<%- include('head.ejs') %>
</head>
<body class="bg-background text-on-background h-screen overflow-hidden flex flex-col font-body-md antialiased">

<!-- Top bar -->
<header class="fixed top-0 w-full z-50 flex justify-between items-center px-3 sm:px-grid-margin py-md bg-background/80 backdrop-blur-xl shadow-md border-b border-white/5">
    <div class="flex items-center gap-2 sm:gap-md min-w-0">
        <a href="<%- url('home') %>" class="text-on-surface-variant hover:text-primary"><%- icon('arrow_forward') %></a>
        <span class="font-bold tracking-tight text-primary text-lg sm:font-display-md sm:text-display-md" dir="ltr">Black Meet</span>
        <span class="hidden md:inline text-on-surface-variant">/</span>
        <span id="meeting-title" class="hidden md:inline font-headline-md text-headline-md text-on-surface truncate"><%- esc(meeting.title) %></span>
    </div>
    <div class="flex items-center gap-2 sm:gap-md">
        <button onclick="toggleSidebar()" id="btn-sidebar" class="relative flex items-center bg-surface-container-highest hover:bg-surface-bright px-3 py-2 rounded-full text-body-sm text-on-surface transition">
            <%- icon('group', 'text-[20px]') %>
            <span id="sidebar-badge" class="hidden absolute -top-1 -right-1 w-3 h-3 bg-error rounded-full border-2 border-background"></span>
        </button>
        <button onclick="copyLink()" class="flex items-center gap-1 sm:gap-2 bg-surface-container-highest hover:bg-surface-bright px-3 py-2 rounded-full text-body-sm text-on-surface transition">
            <%- icon('link', 'text-[20px]') %>
            <span class="hidden sm:inline">کپی لینک</span>
        </button>
        <!-- shared web surface menu: website box / video box -->
        <div class="relative">
            <button id="btn-web" onclick="toggleWebMenu(event)" class="flex items-center gap-1 sm:gap-2 px-3 py-2 rounded-full text-body-sm text-on-surface transition bg-gradient-to-l from-primary-container/70 to-secondary-container/50 border border-primary/40 hover:from-primary-container hover:to-secondary-container/70 hover:shadow-lg hover:shadow-primary/25" title="لینک سایت / ویدیو">
                <%- icon('link', 'text-[20px] text-primary') %>
                <span class="hidden sm:inline font-medium">لینک‌ها</span>
            </button>
            <div id="web-menu" class="hidden fixed z-[75] rounded-2xl overflow-hidden shadow-2xl shadow-black/50 border border-primary/30 bg-gradient-to-b from-surface-container-highest to-surface-container-high min-w-[230px] max-w-[280px]" dir="rtl">
                <div class="flex items-center gap-2 px-3 py-2.5 bg-gradient-to-l from-primary-container/80 to-secondary-container/60 border-b border-white/10">
                    <%- icon('link', 'text-[18px] text-primary') %>
                    <span class="font-label-md text-on-surface">اشتراک لینک</span>
                </div>
                <button type="button" data-no-soft onclick="openWebModal('site')" class="w-full flex items-center gap-3 px-3 py-3 text-right transition-colors hover:bg-primary-container/30">
                    <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-primary-container to-secondary-container text-on-primary-container flex items-center justify-center shrink-0"><%- icon('link', 'text-[20px]') %></span>
                    <span class="min-w-0">
                        <span class="block font-body-sm text-body-sm text-on-surface">لینک سایت</span>
                        <span class="block font-label-sm text-on-surface-variant text-[11px]">نمایش و کنترل سایت زنده</span>
                    </span>
                </button>
                <div class="h-px bg-white/10"></div>
                <button type="button" data-no-soft onclick="openWebModal('video')" class="w-full flex items-center gap-3 px-3 py-3 text-right transition-colors hover:bg-tertiary-container/30">
                    <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-tertiary-container to-secondary-container text-on-tertiary-container flex items-center justify-center shrink-0"><%- icon('movie', 'text-[20px]') %></span>
                    <span class="min-w-0">
                        <span class="block font-body-sm text-body-sm text-on-surface">لینک ویدیو</span>
                        <span class="block font-label-sm text-on-surface-variant text-[11px]">پخش هم‌زمان برای همه</span>
                    </span>
                </button>
                <div class="h-px bg-white/10"></div>
                <button type="button" data-no-soft onclick="openWebModal('audio')" class="w-full flex items-center gap-3 px-3 py-3 text-right transition-colors hover:bg-secondary-container/30">
                    <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-secondary-container to-primary-container text-on-secondary-container flex items-center justify-center shrink-0"><%- icon('volume_up', 'text-[20px]') %></span>
                    <span class="min-w-0">
                        <span class="block font-body-sm text-body-sm text-on-surface">لینک صدا</span>
                        <span class="block font-label-sm text-on-surface-variant text-[11px]">پخش هم‌زمان یک آهنگ یا فایل صوتی</span>
                    </span>
                </button>
            </div>
        </div>
        <div class="hidden sm:flex items-center gap-1 bg-surface-container-highest px-3 py-2 rounded-full" title="وضعیت اتصال زنده">
            <span class="conn-state w-2 h-2 rounded-full bg-secondary"></span>
            <%- icon('groups', 'text-[18px] text-secondary') %>
            <span class="participant-count font-label-sm text-on-surface"><%- participants.length %></span>
        </div>
        <div class="sm:hidden flex items-center bg-surface-container-highest px-2.5 py-2 rounded-full" title="وضعیت اتصال زنده">
            <span class="conn-state w-2 h-2 rounded-full bg-secondary"></span>
            <span class="participant-count font-label-sm text-on-surface mr-1"><%- participants.length %></span>
        </div>
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full flex items-center justify-center font-headline-md text-white" style="background:<%- esc(me.avatar_color) %>"><%- esc(initials) %></div>
    </div>
</header>

<!-- Maximize overlay: a maximized box covers the whole site viewport (the browser chrome
     stays visible because it lives outside the viewport), never off-screen -->
<div id="max-overlay" class="hidden fixed inset-0 z-[90] bg-background"></div>

<!-- Workspace -->
<!-- Sidebar backdrop (mobile) -->
<div id="sidebar-backdrop" class="hidden fixed inset-0 bg-black/50 z-30 md:hidden" onclick="toggleSidebar(false)"></div>

<div class="flex flex-1 pt-[64px] sm:pt-[76px] h-full relative">
    <!-- Sidebar -->
    <aside id="call-sidebar" class="hidden fixed md:relative left-0 top-[64px] sm:top-[76px] md:top-0 bottom-0 md:h-full w-[85%] max-w-[320px] md:w-80 lg:w-96 md:max-w-none z-40 flex-shrink-0 bg-surface-container-low border-l border-outline-variant/20 flex flex-col shadow-xl">
        <div class="flex border-b border-outline-variant/20 px-sm pt-sm">
            <button class="flex-1 pb-3 text-center font-label-md text-primary border-b-2 border-primary transition-colors rounded-t-lg" id="tab-members" onclick="switchTab('members')">اعضا</button>
            <button class="hidden flex-1 pb-3 text-center font-label-md text-on-surface-variant border-b-2 border-transparent transition-colors hover:text-on-surface rounded-t-lg" id="tab-chat" onclick="switchTab('chat')">چت</button>
            <% if (isAdmin) { %>
            <button class="flex-1 pb-3 text-center font-label-md text-on-surface-variant border-b-2 border-transparent transition-colors hover:text-on-surface rounded-t-lg relative" id="tab-admin" onclick="switchTab('admin')">
                ادمین <span id="admin-badge" class="absolute top-0 right-2 w-2 h-2 bg-error rounded-full hidden"></span>
            </button>
            <% } %>
        </div>

        <div class="flex-1 overflow-hidden relative">
            <!-- Members -->
            <div class="absolute inset-0 p-md pb-28 md:pb-md overflow-y-auto custom-scrollbar flex flex-col gap-sm" id="content-members">
                <div id="member-list"></div>
            </div>
            <!-- Chat -->
            <div class="absolute inset-0 p-md pb-28 md:pb-md overflow-y-auto custom-scrollbar hidden flex-col justify-between font-vazir" id="content-chat">
                <div id="chat-messages" class="flex flex-col gap-4"></div>
                <div class="mt-4 pt-4 border-t border-outline-variant/20 relative">
                    <input id="chat-input" class="w-full bg-surface-container rounded-lg border border-outline-variant/30 py-3 pr-4 pl-12 text-body-sm text-on-surface focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all" placeholder="پیام خود را بنویسید..." type="text" onkeydown="if(event.key==='Enter')sendChat()"/>
                    <button onclick="sendChat()" class="absolute left-2 top-[26px] text-primary hover:text-primary-fixed"><%- icon('send', '', true) %></button>
                </div>
            </div>
            <!-- Admin -->
            <% if (isAdmin) { %>
            <div class="absolute inset-0 p-md pb-28 md:pb-md overflow-y-auto custom-scrollbar hidden flex-col gap-sm" id="content-admin">
                <h3 class="font-label-md text-on-surface-variant mb-2">درخواست‌های ورود</h3>
                <div id="join-requests"></div>
                <h3 class="font-label-md text-on-surface-variant mb-2 mt-4">مدیریت اعضا</h3>
                <div id="admin-members"></div>
            </div>
            <% } %>
        </div>
    </aside>

    <!-- Video grid: the stage NEVER scrolls — the grid is sized to the space it has -->
    <main class="flex-1 min-w-0 bg-surface-container-lowest relative p-md overflow-hidden flex flex-col">
        <div id="video-grid" class="call-grid flex-1 min-h-0 pb-24 sm:pb-28"></div>
        <div class="absolute inset-0 pointer-events-none overflow-hidden" id="emoji-canvas"></div>
        <div id="waiting-overlay" class="hidden absolute inset-0 z-30 flex items-center justify-center bg-surface-container-lowest/80 backdrop-blur">
            <div class="text-center">
                <div class="spinner mx-auto mb-4"></div>
                <p class="font-headline-md text-headline-md text-on-surface">در انتظار تایید ادمین برای ورود به تماس...</p>
                <button onclick="alertAdmin()" class="mt-5 mx-auto flex items-center gap-2 bg-secondary-container text-on-secondary-container px-5 py-3 rounded-full font-label-md hover:opacity-90 transition">
                    <%- icon('campaign') %> اطلاع به ادمین
                </button>
            </div>
        </div>
    </main>
</div>

<!-- Bottom control bar. While a box is maximized it collapses into a small floating
     circle (the × at its top-right hides it, the circle brings it back). -->
<nav id="control-bar" class="fixed bottom-3 sm:bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-1 sm:gap-grid-gutter bg-surface-container-highest/60 backdrop-blur-lg border border-white/10 shadow-2xl shadow-black/40 rounded-full px-3 sm:px-6 py-2 sm:py-3 max-w-[calc(100vw-16px)]" dir="ltr">
    <button id="btn-bar-hide" onclick="toggleControlBar(false)" title="محو کردن منو" class="absolute -top-11 right-0 w-9 h-9 rounded-full bg-surface-container-highest/90 backdrop-blur border border-white/15 text-on-surface-variant hover:text-on-surface flex items-center justify-center shadow-lg">
        <%- icon('close', 'text-[18px]') %>
    </button>
    <button id="btn-mic" class="bm-bar-item bg-white/5 text-on-surface rounded-full p-3 hover:bg-white/10 transition-all scale-110 active:scale-90 duration-150 flex flex-col items-center justify-center gap-1 min-w-[64px] group" onclick="toggleMic()">
        <%- icon('mic', 'text-[24px]', true, 'id="ic-mic"') %>
        <span class="font-label-sm text-label-sm text-primary opacity-0 group-hover:opacity-100 transition-opacity absolute -top-6 bg-background/90 px-2 py-0.5 rounded text-[10px]">Mic</span>
    </button>
    <button id="btn-cam" class="bm-bar-item bg-white/5 text-on-surface rounded-full p-3 hover:bg-white/10 transition-all scale-110 active:scale-90 duration-150 flex flex-col items-center justify-center gap-1 min-w-[64px] group" onclick="toggleCam()">
        <%- icon('videocam', 'text-[24px]', true, 'id="ic-cam"') %>
        <span class="font-label-sm text-label-sm text-primary opacity-0 group-hover:opacity-100 transition-opacity absolute -top-6 bg-background/90 px-2 py-0.5 rounded text-[10px]">Camera</span>
    </button>
    <button id="btn-cam-more" class="bm-bar-item hidden bg-white/5 text-on-surface rounded-full p-2.5 hover:bg-white/10 transition-all active:scale-90 duration-150 flex items-center justify-center self-center shrink-0" onclick="toggleCamMenu(event)" aria-label="منبع تصویر">
        <%- icon('more_vert', 'text-[20px]') %>
    </button>
    <button id="btn-chat-panel" class="bm-bar-item bg-white/5 text-on-surface rounded-full p-3 hover:bg-white/10 transition-all scale-110 active:scale-90 duration-150 flex flex-col items-center justify-center gap-1 min-w-[64px] group" onclick="toggleChatPanel()" title="بخش چت">
        <%- icon('forum', 'text-[24px]') %>
        <span class="font-label-sm text-label-sm text-primary opacity-0 group-hover:opacity-100 transition-opacity absolute -top-6 bg-background/90 px-2 py-0.5 rounded text-[10px]">Chat</span>
    </button>
    <div class="bm-bar-item w-px h-8 bg-white/10 mx-1"></div>
    <button id="btn-share" class="bm-bar-item bg-white/5 text-on-surface rounded-full p-3 hover:bg-white/10 transition-all scale-110 active:scale-90 duration-150 flex flex-col items-center justify-center gap-1 min-w-[64px] group" onclick="toggleShare()">
        <%- icon('screen_share', 'text-[24px]') %>
        <span class="font-label-sm text-label-sm text-primary opacity-0 group-hover:opacity-100 transition-opacity absolute -top-6 bg-background/90 px-2 py-0.5 rounded text-[10px]">Share</span>
    </button>
    <button class="bm-bar-item bg-white/5 text-on-surface rounded-full p-3 hover:bg-white/10 transition-all scale-110 active:scale-90 duration-150 flex flex-col items-center justify-center gap-1 min-w-[64px] group relative" onclick="toggleEmojiPicker()">
        <%- icon('mood', 'text-[24px]') %>
        <span class="font-label-sm text-label-sm text-primary opacity-0 group-hover:opacity-100 transition-opacity absolute -top-6 bg-background/90 px-2 py-0.5 rounded text-[10px]">Emoji</span>
    </button>
    <div class="bm-bar-item w-px h-8 bg-white/10 mx-1"></div>
    <button class="bm-bar-item bg-tertiary-container text-on-tertiary-container rounded-full p-3 hover:bg-error transition-all scale-110 active:scale-90 duration-150 flex flex-col items-center justify-center gap-1 min-w-[64px] group" onclick="leaveCall()">
        <%- icon('call_end', 'text-[24px]') %>
        <span class="font-label-sm text-label-sm text-primary opacity-0 group-hover:opacity-100 transition-opacity absolute -top-6 bg-background/90 px-2 py-0.5 rounded text-[10px]">Leave</span>
    </button>
</nav>

<!-- Collapsed state of the control bar -->
<button id="btn-bar-show" onclick="toggleControlBar(true)" title="نمایش منو" class="hidden fixed bottom-6 right-6 z-[95] w-14 h-14 rounded-full bg-surface-container-highest/90 backdrop-blur-lg border border-white/15 shadow-2xl shadow-black/50 text-on-surface items-center justify-center">
    <%- icon('menu', 'text-[24px]') %>
</button>

<!-- Emoji picker popup -->
<div id="emoji-picker" class="hidden fixed bottom-20 sm:bottom-24 left-1/2 -translate-x-1/2 z-[60] glass-panel rounded-2xl p-3 sm:p-4 shadow-2xl max-w-[calc(100vw-24px)]">
    <div class="grid grid-cols-6 gap-2" id="emoji-grid"></div>
</div>

<!-- Camera source menu (⋮ next to the cam button): front/back + real devices -->
<div id="cam-menu" class="hidden fixed z-[70] glass-panel rounded-xl p-1.5 shadow-2xl shadow-black/40 border border-white/10 min-w-[200px] max-w-[260px]" dir="rtl"></div>

<!-- Chat message bubble: rises from bottom for other members, fades after 5s, click opens chat -->
<button type="button" id="chat-toast" class="hidden fixed bottom-24 sm:bottom-28 left-1/2 -translate-x-1/2 z-[55] max-w-[calc(100vw-32px)] flex items-center gap-3 bg-surface-container-highest/95 backdrop-blur-lg border border-white/10 shadow-2xl shadow-black/40 rounded-full pl-4 pr-3 py-2.5 cursor-pointer" onclick="openChatFromToast()">
    <span class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center shrink-0"><%- icon('forum', 'text-[18px]', true) %></span>
    <span class="min-w-0 text-right">
        <span id="ct-name" class="block font-label-sm text-primary truncate max-w-[160px] sm:max-w-[240px]"></span>
        <span id="ct-body" class="block font-body-sm text-body-sm text-on-surface truncate max-w-[180px] sm:max-w-[320px]"></span>
    </span>
</button>

<!-- Member info panel (glowing steel boxes) -->
<div id="member-info" class="hidden fixed inset-0 z-[80] flex items-center justify-center bg-background/70 backdrop-blur-sm p-4">
    <div class="glass-panel rounded-2xl p-xl shadow-2xl w-full max-w-[560px]">
        <div class="flex items-center justify-between mb-lg">
            <div class="flex items-center gap-3 min-w-0">
                <div id="mi-avatar" class="w-14 h-14 rounded-full overflow-hidden border border-white/20 flex-shrink-0 flex items-center justify-center font-headline-md text-white"></div>
                <div class="min-w-0">
                    <h3 id="mi-name" class="font-headline-md text-headline-md text-on-surface truncate"></h3>
                    <p id="mi-sub" class="font-label-sm text-on-surface-variant text-[12px]"></p>
                </div>
            </div>
            <button onclick="closeMemberInfo()" class="text-on-surface-variant hover:text-on-surface p-1"><%- icon('close') %></button>
        </div>
        <div id="mi-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
    </div>
</div>

<!-- Right-click member context menu -->
<div id="member-menu" class="hidden fixed z-[70] glass-panel rounded-xl p-3 shadow-2xl w-56">
    <div class="font-label-md text-on-surface mb-3 truncate" id="member-menu-name"></div>
    <label class="flex items-center justify-between text-body-sm text-on-surface mb-3 cursor-pointer">
        <span>بی‌صدا برای من</span>
        <input type="checkbox" id="mm-mute" onchange="memberMenuMute(this.checked)"/>
    </label>
    <div class="flex items-center justify-between text-body-sm text-on-surface gap-2">
        <span>صدا</span>
        <input type="range" min="0" max="100" value="100" class="flex-1" id="mm-vol" oninput="memberMenuVolume(this.value)"/>
    </div>
</div>

<!-- Screen-share pre-flight: quality + share audio -->
<div id="share-panel" class="hidden fixed inset-0 z-[85] flex items-center justify-center bg-background/70 backdrop-blur-sm p-4">
    <div class="glass-panel rounded-2xl p-xl shadow-2xl w-full max-w-[430px]">
        <div class="flex items-center justify-between mb-lg">
            <h3 class="font-headline-md text-headline-md text-on-surface">اشتراک صفحه</h3>
            <button type="button" onclick="closeSharePanel()" class="text-on-surface-variant hover:text-on-surface p-1"><%- icon('close') %></button>
        </div>

        <!-- themed quality picker (a real menu, not the browser's native select) -->
        <div class="relative mb-md">
            <span class="font-label-sm text-on-surface-variant mb-1 block">کیفیت تصویر</span>
            <button type="button" id="share-quality-btn" onclick="toggleQualityMenu(event)" aria-haspopup="true" aria-expanded="false" class="w-full flex items-center justify-between gap-2 bg-surface-container border border-outline-variant/40 hover:border-primary-container rounded-xl px-4 py-3 font-body-sm text-body-sm text-on-surface transition-colors">
                <span class="flex items-center gap-2 min-w-0">
                    <span id="share-quality-icon" class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary-container to-secondary-container text-on-primary-container flex items-center justify-center shrink-0"><%- icon('tune', 'text-[18px]') %></span>
                    <span id="share-quality-label" class="truncate">720p — پیشنهادی</span>
                </span>
                <span class="bm-caret text-on-surface-variant"></span>
            </button>
            <div id="share-quality-menu" class="hidden absolute left-0 right-0 top-full mt-2 z-10 glass-panel rounded-xl shadow-2xl border border-outline-variant/30 p-1.5 max-h-[240px] overflow-y-auto custom-scrollbar">
                <button type="button" data-q="360"  onclick="pickQuality(360)"><span class="block font-body-sm text-body-sm text-on-surface">360p</span><span class="block font-label-sm text-on-surface-variant text-[11px]">کم‌حجم‌ترین، برای اینترنت ضعیف</span></button>
                <button type="button" data-q="480"  onclick="pickQuality(480)"><span class="block font-body-sm text-body-sm text-on-surface">480p</span><span class="block font-label-sm text-on-surface-variant text-[11px]">سبک و قابل قبول</span></button>
                <button type="button" data-q="720"  onclick="pickQuality(720)"><span class="block font-body-sm text-body-sm text-on-surface">720p — پیشنهادی</span><span class="block font-label-sm text-on-surface-variant text-[11px]">تعادل کیفیت و روانی</span></button>
                <button type="button" data-q="1080" onclick="pickQuality(1080)"><span class="block font-body-sm text-body-sm text-on-surface">1080p</span><span class="block font-label-sm text-on-surface-variant text-[11px]">بهترین کیفیت، نیاز به اینترنت خوب</span></button>
                <button type="button" data-q="0"    onclick="pickQuality(0)"><span class="block font-body-sm text-body-sm text-on-surface">کیفیت اصلی</span><span class="block font-label-sm text-on-surface-variant text-[11px]">بدون محدودیت، مطابق صفحه</span></button>
            </div>
        </div>
        <input type="hidden" id="share-quality" value="720"/>

        <label class="flex items-center justify-between gap-3 px-3 py-3 rounded-lg bg-surface-container-highest border border-outline-variant/30 cursor-pointer">
            <span class="flex items-center gap-2 font-body-sm text-on-surface">
                <%- icon('volume_up', 'text-[18px] text-primary') %>
                اشتراک صدای صفحه
            </span>
            <span class="relative inline-flex items-center shrink-0">
                <input type="checkbox" id="share-audio" class="peer sr-only" checked/>
                <span class="w-11 h-6 rounded-full bg-surface-container-highest border border-outline-variant/40 transition-colors peer-checked:bg-primary/80"></span>
                <span class="absolute right-0.5 w-5 h-5 rounded-full bg-on-surface-variant transition-all peer-checked:right-[22px] peer-checked:bg-on-primary"></span>
            </span>
        </label>
        <p class="font-body-sm text-[12px] text-on-surface-variant mt-2 mb-lg">در پنجره‌ی مرورگر گزینه «اشتراک صدای صفحه/زبانه» را هم تیک بزنید.</p>
        <div class="flex items-center gap-3">
            <button type="button" onclick="confirmShare()" class="btn-primary flex-1 text-center">شروع اشتراک</button>
            <button type="button" onclick="closeSharePanel()" class="btn-secondary flex-1 text-center">انصراف</button>
        </div>
    </div>
</div>

<!-- Shared website / video -->
<div id="web-modal" class="hidden fixed inset-0 z-[85] flex items-center justify-center bg-background/70 backdrop-blur-sm p-4">
    <div class="glass-panel rounded-3xl p-xl shadow-2xl w-full max-w-[520px] border border-primary/25 overflow-hidden">
        <div class="flex items-center gap-3 mb-lg">
            <span id="web-modal-badge" class="w-12 h-12 rounded-2xl bg-gradient-to-br from-primary-container to-secondary-container text-on-primary-container flex items-center justify-center shadow-lg shadow-primary/20">
                <%- icon('link', 'text-[26px]') %>
            </span>
            <div class="min-w-0">
                <h3 id="web-modal-title" class="font-headline-md text-headline-md text-on-surface">نمایش لینک سایت</h3>
                <p id="web-modal-hint" class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">آدرس سایتی که می‌خواهید به همه نشان دهید را وارد کنید</p>
            </div>
            <button type="button" onclick="closeWebModal()" class="mr-auto text-on-surface-variant hover:text-on-surface p-1"><%- icon('close') %></button>
        </div>
        <div class="relative mb-md">
            <input id="web-url" dir="ltr" class="form-input pr-11" placeholder="https://example.com" type="text" inputmode="url"/>
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none"><%- icon('link', 'text-[18px]') %></span>
        </div>
        <p class="font-body-sm text-[12px] text-on-surface-variant mb-md bg-surface-container-low border border-outline-variant/30 rounded-xl px-3 py-2">
            باکس به همه‌ی اعضای تماس نشان داده می‌شود و همه می‌توانند آن را کنترل کنند (ادمین می‌تواند محدود کند).
        </p>
        <label class="flex items-center justify-between gap-3 px-3 py-3 rounded-xl bg-gradient-to-l from-primary-container/40 to-secondary-container/30 border border-primary/25 mb-lg cursor-pointer">
            <span class="min-w-0">
                <span class="block font-body-sm text-body-sm text-on-surface">دسترسی همزمان</span>
                <span class="block font-label-sm text-on-surface-variant text-[11px]">اگر روشن باشد، اسکرول و کلیک یا پخش و توقف یک نفر روی صفحه‌ی همه اعمال می‌شود</span>
            </span>
            <span class="relative inline-flex items-center shrink-0">
                <input type="checkbox" id="web-follow" class="peer sr-only" checked onchange="setWebFollow(this.checked)"/>
                <span class="w-11 h-6 rounded-full bg-surface-container-highest border border-outline-variant/40 transition-colors peer-checked:bg-primary/80"></span>
                <span class="absolute right-0.5 w-5 h-5 rounded-full bg-on-surface-variant transition-all peer-checked:right-[22px] peer-checked:bg-on-primary"></span>
            </span>
        </label>
        <div class="flex items-center gap-3">
            <button type="button" onclick="submitWebModal()" class="btn-primary flex-1 text-center">تایید</button>
            <button type="button" onclick="closeWebModal()" class="btn-secondary flex-1 text-center">انصراف</button>
        </div>
    </div>
</div>

<!-- Admin: who may control / who may watch the shared box -->
<div id="web-admin" class="hidden fixed inset-0 z-[85] flex items-center justify-center bg-background/70 backdrop-blur-sm p-4">
    <div class="glass-panel rounded-2xl p-xl shadow-2xl w-full max-w-[520px] max-h-[85vh] overflow-y-auto custom-scrollbar">
        <div class="flex items-center justify-between mb-lg">
            <h3 class="font-headline-md text-headline-md text-on-surface">دسترسی باکس</h3>
            <button type="button" onclick="closeWebAdmin()" class="text-on-surface-variant hover:text-on-surface p-1"><%- icon('close') %></button>
        </div>
        <p class="font-label-sm text-on-surface-variant mb-2">چه کسانی بتوانند صفحه/ویدیو را کنترل کنند</p>
        <div id="web-admin-control" class="mb-lg"></div>
        <div id="web-admin-view-wrap" class="mb-lg">
            <p class="font-label-sm text-on-surface-variant mb-2">چه کسانی ویدیو را ببینند</p>
            <div id="web-admin-view"></div>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" onclick="applyWebAdmin()" class="btn-primary flex-1">اعمال</button>
            <button type="button" onclick="removeWebBox()" class="btn-secondary">حذف باکس</button>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="fixed bottom-6 right-6 hidden z-50" id="toast"><div class="bg-error-container text-on-error-container px-6 py-3 rounded-lg shadow-xl flex items-center gap-3">
    <%- icon('error') %><span id="toast-message"></span></div></div>

<script src="/socket.io/socket.io.js"></script>
<script>window.INIT = <%- json(init) %>; window.__BM_isManager = <%- json(isManager) %>;</script>
<script src="<%- asset('assets/js/emoji-sfx.js') %>"></script>
<script>
  // Sidebar open/close: one button toggles chat/members/admin on ALL screen sizes.
  window.toggleSidebar = function (force) {
    const sb = document.getElementById('call-sidebar');
    const bd = document.getElementById('sidebar-backdrop');
    const btn = document.getElementById('btn-sidebar');
    const isMobile = window.innerWidth < 768;
    const show = force !== undefined ? force : sb.classList.contains('hidden');
    sb.classList.toggle('hidden', !show);
    if (bd) bd.classList.toggle('hidden', !(show && isMobile));
    if (btn) {
      btn.classList.toggle('bg-secondary-container', show);
      btn.classList.toggle('text-on-secondary-container', show);
      btn.classList.toggle('bg-surface-container-highest', !show);
    }
    // the stage just changed width: the video grid must be re-sized or the boxes
    // keep the old row heights and spill out of the page
    if (window.bmCallRelayout) window.bmCallRelayout();
  };
  // On first load: open on desktop, closed on mobile
  window.addEventListener('DOMContentLoaded', () => {
    toggleSidebar(window.innerWidth >= 768);
  });
</script>
<script src="<%- asset('assets/js/call.js') %>"></script>
<script src="<%- asset('assets/js/call-web.js') %>"></script>
</body>
</html>